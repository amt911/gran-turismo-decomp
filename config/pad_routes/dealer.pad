# Route B — Car Dealerships: the dealer list, a car's 3D view and its catalogue sheet; never buys (300 s).
# Waits for the game, not for a time (host/pad_sequence.hpp; race.pad explains): WAIT:seek=<offset> holds until the game seeks GT.VOL to the
# entry of the page it is loading (FACTS § Page loads as screen signals) and the times after it count from there. Offsets: 1fa48900 main menu,
# 1cdb3240 Car Dealerships, 1cd65580 a car's page, 1d032dc0 its catalogue sheet.
3300:START,
WAIT:seek=0x1fa48900,1700:RIGHT,1800:RIGHT,1900:CROSS,
WAIT:seek=0x1cdb3240,666:CROSS,1466:RIGHT,1566:RIGHT,1666:CROSS,
WAIT:seek=0x1cd65580,796:CIRCLE,1196:CIRCLE,1596:CIRCLE,2196:DOWN,2296:RIGHT,2396:RIGHT,2496:CROSS,3296:DOWN,3396:CROSS,
WAIT:seek=0x1cd65580,797:CIRCLE,1197:CIRCLE,1597:LEFT,1697:CROSS,
WAIT:seek=0x1d032dc0,730:CROSS,1530:CIRCLE,1930:CIRCLE
