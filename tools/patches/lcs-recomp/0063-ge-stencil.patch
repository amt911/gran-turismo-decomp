+// GT patch 0063 — the stencil (PPSSPP GPU/Software): the test compares (ref & mask) with (alpha & mask); each op gives
+// the new alpha: keep, zero, replace (ref), invert, incr, decr (saturating; one step of the format's alpha bits).
+bool stencil_test_passes(std::uint8_t stencil, const FragmentSetup &setup) noexcept {
+    return compare_value(setup.stencil_function, setup.stencil_reference & setup.stencil_mask,
+                         stencil & setup.stencil_mask);
+}
+
+std::uint8_t stencil_apply(std::uint32_t op, std::uint8_t stencil, const FragmentSetup &setup) noexcept {
+    const std::uint32_t step = setup.framebuffer_format == 3u ? 1u : setup.framebuffer_format == 2u ? 0x11u : 0xFFu;
+    switch (op) {
+    case 1u: return 0u;
+    case 2u: return static_cast<std::uint8_t>(setup.stencil_reference);
+    case 3u: return static_cast<std::uint8_t>(~stencil);
+    case 4u: return static_cast<std::uint8_t>(std::min<std::uint32_t>(stencil + step, 0xFFu));
+    case 5u: return static_cast<std::uint8_t>(stencil > step ? stencil - step : 0u);
+    default: return stencil;
+    }
+}
+
+// Writes only the alpha (the stencil) of a pixel, through the alpha write mask.
+void write_stencil_only(psprecomp::GuestMemory &memory, const FragmentSetup &setup, std::uint8_t *pixel,
