     if ((texture_address & 0x0F000000u) != 0x04000000u) return nullptr;
-    return find_target(s, texture_address);
+    Target *target = find_target(s, texture_address);
+    // GT patch 0033: only a target the GE drew into lately holds what that memory holds. GT renders a menu
+    // label into VRAM, leaves the menu, then loads a texture (the kerbs) over those bytes with the CPU, which the
+    // backend never sees: the stale target drew "Single Player" on the kerbs. Effects that sample a target (a
+    // mirror, an environment map) render into it every frame.
+    if (target != nullptr && s.frame_epoch > target->last_draw_epoch + kTargetFreshFrames) return nullptr;
+    return target;
