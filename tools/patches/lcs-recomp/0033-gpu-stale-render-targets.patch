+// GT patch 0034: the whole-scale cap Window mode keeps under a GPU budget. `current` is the scale drawing now,
+// `cap` the cap so far (0: none yet), `mean_ms` the GPU's mean time per frame over the last window, and
+// `seconds_since_change` the time since the cap last moved. Over budget: one scale down (not below x1); when the
+// next scale up would cost, by pixel count, under 70 % of the budget and the last change is at least 6 s old:
+// one up (not above `max_scale`). Budget 0: off, `max_scale`.
+[[nodiscard]] constexpr std::uint32_t budget_scale_cap(std::uint32_t current, std::uint32_t cap, std::uint32_t max_scale,
+                                                       double mean_ms, std::uint32_t budget_ms,
+                                                       double seconds_since_change) noexcept {
+    if (budget_ms == 0u) return max_scale;
+    if (cap == 0u || cap > max_scale) cap = max_scale;
+    if (current < 1u) current = 1u;
+    const double budget = static_cast<double>(budget_ms);
+    if (mean_ms > budget) return current > 1u ? current - 1u : 1u;
+    const double next = static_cast<double>(current + 1u) / static_cast<double>(current);
+    if (mean_ms * next * next < 0.7 * budget && cap < max_scale && seconds_since_change >= 6.0) return current + 1u;
+    return cap;
+}
+
 [[nodiscard]] InternalResolutionDimensions resolve_internal_resolution(
     const RenderingConfiguration &configuration) noexcept;
 
