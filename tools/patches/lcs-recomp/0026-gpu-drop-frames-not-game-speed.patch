+// GT patch 0026: whether the GPU is still drawing the pending submit after waiting at most `wait` for it. A
+// fast GPU finishes within a few milliseconds even when GT ends two frames back to back; a slow one doesn't.
+bool gpu_still_busy(const VulkanState &s, std::chrono::microseconds wait = std::chrono::microseconds{0}) noexcept {
+    if (!s.submit_pending) return false;
+    static const double simulated_ms = [] { const char *v = std::getenv("GT_SIM_GPU_MS"); return v ? std::atof(v) : 0.0; }();
+    if (simulated_ms > 0.0) {
+        const auto done = s.submit_time + std::chrono::microseconds(static_cast<long long>(simulated_ms * 1000.0));
+        const auto now = std::chrono::steady_clock::now();
+        if (now >= done) return false;
+        if (now + wait < done) {
+            std::this_thread::sleep_for(wait);
+            return true;
+        }
+        std::this_thread::sleep_until(done);
+        return false;
+    }
+    const auto nanoseconds = static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(wait).count());
+    return vkWaitForFences(s.device, 1u, &s.frame_fence, VK_TRUE, nanoseconds) == VK_TIMEOUT;
+}
+
+// GT patch 0026: whether this frame only draws into shown framebuffers, so dropping it loses nothing later
+// frames need.
+bool frame_droppable(const VulkanState &s) noexcept {
+    static const bool disabled = std::getenv("GT_GPU_NO_DROP") != nullptr;  // deterministic runs (tools/gpu_gate.sh)
+    // At most two frames in a row are dropped, so a shown framebuffer GT keeps drawing into is never more than
+    // two frames stale.
+    if (disabled || s.batches.empty() || s.consecutive_drops >= 2u) return false;
+    for (const Batch &batch : s.batches) {
+        const std::uint32_t address = batch.draw.framebuffer_address & 0x001FFFF0u;
+        if (std::find(s.display_targets.begin(), s.display_targets.end(), address) == s.display_targets.end())
+            return false;
+    }
+    return true;
+}
