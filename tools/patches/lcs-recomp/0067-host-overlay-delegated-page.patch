@@ -354,6 +354,42 @@ int f9_key() {
     return 0;
 }
 
+// A delegated page (GT: the cheat device): the page gets the keys and fills the view itself; false from `key` closes the overlay.
+std::vector<int> g_delegated_keys;
+bool delegated_key(lcs::HostSettingsKey key) {
+    g_delegated_keys.push_back(static_cast<int>(key));
+    return key != lcs::HostSettingsKey::Close;  // the page is at its root: Close closes
+}
+void delegated_view(lcs::HostSettingsView &view) {
+    view.row_count = lcs::kViewRows;
+    view.selected = 7;
+    for (int row = 0; row < lcs::kViewRows; ++row) std::snprintf(view.rows[row], sizeof(view.rows[row]), "ROW%d", row);
+    std::snprintf(view.title, sizeof(view.title), "Cheats > Race");
+}
+
+int delegated_page() {
+    using namespace lcs;
+    static const HostExtraPage page{"CHEATS", nullptr, nullptr, nullptr, nullptr, delegated_key, delegated_view, true};
+    host_settings_set_extra_page(&page);
+    if (!host_settings_handle(HostSettingsKey::TogglePage) || !host_settings_open()) return fail("open the delegated page");
+    host_settings_handle(HostSettingsKey::Up);
+    host_settings_handle(HostSettingsKey::Activate);
+    if (g_delegated_keys != std::vector<int>{static_cast<int>(HostSettingsKey::Up), static_cast<int>(HostSettingsKey::Activate)})
+        return fail("the page gets Up and Activate");
+    const HostSettingsView view = host_settings_view();
+    if (view.row_count != kViewRows || std::string(view.rows[7]) != "ROW7" || view.selected != 7 ||
+        std::string(view.title) != "Cheats > Race")
+        return fail("the page fills the view (8 rows)");
+    host_settings_handle(HostSettingsKey::Close);
+    if (host_settings_open()) return fail("Close at the page's root closes the overlay");
+    // The page owns its open key: F9 is not the overlay's (the host binds the device's open key itself).
+    const Win32HostKeyDecision f9 = classify_win32_host_key(kWin32KeyDown, kWin32VkF9, false);
+    if (f9.consume || f9.toggle_page) return fail("F9 left to the host for a page that owns its open key");
+    host_settings_set_extra_page(nullptr);
+    std::cout << "delegated=keys to the page, 8 rows, close on false, F9 free\n";
+    return 0;
+}
+
 }  // namespace
 
