+// GT patch 0044: the bilinear filter at the PSP's own pixel centres never reaches more than half a texel past the
+// texture coordinates a draw's vertices span, so the texels outside that range never show on the console. At an
+// internal scale the pixel centres along the draw's edges fall between texels and the filter blended them in: GT
+// draws its full-screen pictures from the top 480x272 of a 512x512 texture whose next row holds the palette, and
+// that row showed as a thin line of changing colour along the bottom of the screen. Keeping the sample at least
+// half a texel inside the range is a no-op at 1x for draws that map texels to pixels one to one. A side of the
+// range that reaches the texture's edge (or beyond: a repeating texture) stays open, so tiled textures still wrap.
+void extend_uv_box(Batch &batch, float u, float v, float q) noexcept {
+    if (!std::isfinite(u) || !std::isfinite(v) || std::fabs(q - 1.0f) > 1.0e-6f) {
+        batch.uv_box_valid = false;
+        batch.uv_box[0] = -1.0e30f;  // stays invalid after a merge
+        return;
+    }
+    if (batch.uv_box[0] <= -1.0e30f) return;
+    if (!batch.uv_box_valid) {
+        batch.uv_box_valid = true;
+        batch.uv_box[0] = batch.uv_box[2] = u;
+        batch.uv_box[1] = batch.uv_box[3] = v;
+        return;
+    }
+    batch.uv_box[0] = std::min(batch.uv_box[0], u);
+    batch.uv_box[1] = std::min(batch.uv_box[1], v);
+    batch.uv_box[2] = std::max(batch.uv_box[2], u);
+    batch.uv_box[3] = std::max(batch.uv_box[3], v);
+}
+
+void apply_uv_clamp(const Batch &batch, DrawUniforms &uniforms) noexcept {
+    const GeGpuDrawDescriptor &draw = batch.draw;
+    if (!batch.uv_box_valid || !draw.texture_enabled || (!draw.texture_min_linear && !draw.texture_mag_linear) ||
+        draw.texture_width == 0u || draw.texture_height == 0u)
+        return;
+    constexpr float kEdge = 1.0e-4f;
+    const auto axis = [&](float low, float high, std::uint32_t size, float &clamp_low, float &clamp_high) {
+        if (low < -kEdge || high > 1.0f + kEdge) return;  // a repeating texture: leave the axis open
+        const float half = 0.5f / static_cast<float>(size);
+        if (low > kEdge) clamp_low = low + half;
+        if (high < 1.0f - kEdge) clamp_high = high - half;
+        if (clamp_low > clamp_high) clamp_low = clamp_high = (low + high) * 0.5f;  // narrower than a texel
+    };
+    axis(batch.uv_box[0], batch.uv_box[2], draw.texture_width, uniforms.uv_clamp[0], uniforms.uv_clamp[2]);
+    axis(batch.uv_box[1], batch.uv_box[3], draw.texture_height, uniforms.uv_clamp[1], uniforms.uv_clamp[3]);
+}
