+// GT patch 0070: the UI picture comes from its own thread, equals a direct rasterization, is not redone for the same view, and
+// is sized from the output resolution.
+int async_picture() {
+    using namespace lcs;
+    const SettingsOverlaySize fhd = settings_overlay_present_size(1920.0f, 1080.0f);
+    if (fhd.width != 768u || fhd.height != 756u) return fail("1080p: 40 % of the width, the layout's shape");
+    const SettingsOverlaySize uhd = settings_overlay_present_size(3840.0f, 2160.0f);
+    if (uhd.width != 1536u) return fail("4K: the picture grows with the output (sharp, not a 1040 px texture stretched)");
+    const SettingsOverlaySize wide = settings_overlay_present_size(3440.0f, 1000.0f);
+    if (static_cast<float>(wide.height) > 1000.0f * 0.80f + 1.0f) return fail("a wide output: the height caps it");
+    if (settings_overlay_present_size(320.0f, 240.0f).width > 320u - 48u) return fail("a small output: inside the margins");
+    if (!host_style_font_available()) return fail("the UI font (tools/setup.sh fetches Barlow) is not available");
+    HostSettingsView view = device_like_view();
+    const SettingsOverlaySize size{600u, 591u};
+    const auto wait_for = [&](std::uint64_t newer_than) {
+        SettingsOverlayPicture p{};
+        for (int i = 0; i < 400 && p.version <= newer_than; ++i) {
+            p = settings_overlay_request(view, size);
+            if (p.version <= newer_than) std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+        return p;
+    };
+    const unsigned long before = host_style_raster_count();
+    const SettingsOverlayPicture first = wait_for(0u);
+    if (first.version == 0u || first.width != 600u || first.height != 591u) return fail("the worker finishes a picture of the size asked");
+    std::vector<std::uint8_t> got(static_cast<std::size_t>(600u) * 591u * 4u), direct(got.size());
+    if (!settings_overlay_copy(first.version, got.data(), got.size())) return fail("the newest picture can be copied");
+    if (settings_overlay_copy(first.version + 1u, got.data(), got.size())) return fail("a version that is not the newest is refused");
+    rasterize_settings_overlay(view, direct.data(), 600u, 591u);
+    if (got != direct) return fail("the worker's picture equals a direct rasterization");
+    const unsigned long settled = host_style_raster_count();
+    for (int i = 0; i < 5; ++i) settings_overlay_request(view, size);
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    if (settings_overlay_request(view, size).version != first.version) return fail("the same view is not rasterized again");
+    if (host_style_raster_count() != settled || settled <= before) return fail("the worker rasterized once; repeats do nothing");
+    view.selected = 2;
+    const SettingsOverlayPicture moved = wait_for(first.version);
+    if (moved.version <= first.version) return fail("a cursor move gives a new picture");
+    std::cout << "async_picture=worker thread, same as direct, cached, sized from the output\n";
+    return 0;
+}
