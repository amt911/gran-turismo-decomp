+// GT patch 0070: the host UI is rasterized at the size it is shown at, so it scales with the output resolution: 40 % of the
+// output width, at most 80 % of its height (the 520 x 512 layout keeps its shape), never below 360 px wide nor wider than the
+// output less the 24 px margins. Without the UI font the old fixed 1040 x 1024 texture is used (the 5x7 fallback look).
+struct SettingsOverlaySize {
+    std::uint32_t width{0}, height{0};
+};
+[[nodiscard]] inline SettingsOverlaySize settings_overlay_present_size(float output_width, float output_height) noexcept {
+    constexpr float kLayoutW = 520.0f, kLayoutH = 512.0f;
+    float width = output_width * 0.40f;
+    const float by_height = output_height * 0.80f * kLayoutW / kLayoutH;
+    if (width > by_height) width = by_height;
+    if (width < 360.0f) width = 360.0f;
+    const float room = output_width - 48.0f;
+    if (width > room) width = room > 64.0f ? room : 64.0f;
+    const auto w = static_cast<std::uint32_t>(width + 0.5f);
+    return {w, static_cast<std::uint32_t>(static_cast<float>(w) * kLayoutH / kLayoutW + 0.5f)};
+}
+
+// GT patch 0070: the host UI picture is rasterized on its own thread, never on the thread that presents (a full redraw costs
+// milliseconds; on that thread every cursor move stalled the game). settings_overlay_request posts the view and the size wanted
+// and returns the newest finished picture, which may be an older request (version 0: none yet); the same view and size twice
+// rasterize once. settings_overlay_copy copies that picture out if it is still the newest one (false: a newer one replaced it,
+// ask again next frame). Presenters upload only when the version changes.
+struct SettingsOverlayPicture {
+    std::uint32_t width{0}, height{0};
+    std::uint64_t version{0};
+};
+SettingsOverlayPicture settings_overlay_request(const HostSettingsView &view, SettingsOverlaySize size) noexcept;
+bool settings_overlay_copy(std::uint64_t version, std::uint8_t *rgba, std::size_t capacity) noexcept;
+// Tests: rasterize on the calling thread instead (the request then returns the picture of this very view).
+void settings_overlay_set_synchronous(bool synchronous) noexcept;
