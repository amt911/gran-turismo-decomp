+namespace {
+
+// GT patch 0070: the UI picture worker. One request slot (the newest view wins: a cursor moving faster than the worker skips
+// the pictures in between), one finished picture. The worker thread is started on the first request and lives until exit.
+struct OverlayWorker {
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool synchronous = false;
+    bool started = false;
+    bool pending = false;        // `wanted` not rasterized yet
+    HostSettingsView wanted{};
+    SettingsOverlaySize wanted_size{};
+    bool have_last = false;      // the last request taken (to skip an identical one)
+    HostSettingsView last{};
+    SettingsOverlaySize last_size{};
+    std::vector<std::uint8_t> picture;  // finished
+    SettingsOverlayPicture info{};
+    std::uint64_t versions = 0;
+};
+
+OverlayWorker &overlay_worker() {
+    static OverlayWorker *worker = new OverlayWorker();  // never destroyed: the detached thread may still hold it at exit
+    return *worker;
+}
+
+bool same_view(const HostSettingsView &a, const HostSettingsView &b) { return std::memcmp(&a, &b, sizeof a) == 0; }
+
+SettingsOverlaySize raster_size(SettingsOverlaySize size) {
+    if (!host_style_font_available() || size.width == 0u || size.height == 0u) return {kSettingsOverlayWidth, kSettingsOverlayHeight};
+    return size;
+}
+
+// Rasterizes `view` (outside the lock) and publishes it.
+void overlay_rasterize(OverlayWorker &w, const HostSettingsView &view, SettingsOverlaySize size, std::unique_lock<std::mutex> &lock) {
+    lock.unlock();
+    const SettingsOverlaySize real = raster_size(size);
+    std::vector<std::uint8_t> pixels(static_cast<std::size_t>(real.width) * real.height * 4u);
+    rasterize_settings_overlay(view, pixels.data(), real.width, real.height);
+    lock.lock();
+    w.picture.swap(pixels);
+    w.info = SettingsOverlayPicture{real.width, real.height, ++w.versions};
+}
+
+void overlay_thread() {
+    OverlayWorker &w = overlay_worker();
+    std::unique_lock<std::mutex> lock(w.mutex);
+    for (;;) {
+        w.wake.wait(lock, [&w] { return w.pending; });
+        const HostSettingsView view = w.wanted;
+        const SettingsOverlaySize size = w.wanted_size;
+        w.pending = false;
+        overlay_rasterize(w, view, size, lock);
+    }
+}
+
+}  // namespace
+
+SettingsOverlayPicture settings_overlay_request(const HostSettingsView &view, SettingsOverlaySize size) noexcept {
+    OverlayWorker &w = overlay_worker();
+    std::unique_lock<std::mutex> lock(w.mutex);
+    const bool repeat = w.have_last && w.last_size.width == size.width && w.last_size.height == size.height && same_view(w.last, view);
+    if (!repeat) {
+        w.have_last = true;
+        w.last = view;
+        w.last_size = size;
+        if (w.synchronous) {
+            overlay_rasterize(w, view, size, lock);
+        } else {
+            w.wanted = view;
+            w.wanted_size = size;
+            w.pending = true;
+            if (!w.started) {
+                w.started = true;
+                try {
+                    std::thread(overlay_thread).detach();
+                } catch (...) {  // no thread: rasterize here, as before
+                    w.synchronous = true;
+                    w.pending = false;
+                    overlay_rasterize(w, view, size, lock);
+                }
+            }
+            w.wake.notify_one();
+        }
+    }
+    return w.info;
+}
+
+bool settings_overlay_copy(std::uint64_t version, std::uint8_t *rgba, std::size_t capacity) noexcept {
+    OverlayWorker &w = overlay_worker();
+    std::lock_guard<std::mutex> lock(w.mutex);
+    if (version == 0u || w.info.version != version || rgba == nullptr || capacity < w.picture.size()) return false;
+    std::memcpy(rgba, w.picture.data(), w.picture.size());
+    return true;
+}
+
+void settings_overlay_set_synchronous(bool synchronous) noexcept {
+    OverlayWorker &w = overlay_worker();
+    std::lock_guard<std::mutex> lock(w.mutex);
+    w.synchronous = synchronous;
+}
