     static constexpr unsigned kChunksPerParticipant = 4u;
     static constexpr unsigned kWorkerSpins = 262144u;
 
+    // PSPRECOMP_RASTER_SPINS: pause iterations an idle worker spins before it parks (default
+    // kWorkerSpins). Spinning idle workers cost whole cores, which a power-limited CPU takes from the
+    // threads doing the work.
+    static unsigned worker_spins() noexcept {
+        static const unsigned spins = [] {
+            const char *text = std::getenv("PSPRECOMP_RASTER_SPINS");
+            if (text == nullptr || *text == '\0') return kWorkerSpins;
+            char *end = nullptr;
+            const unsigned long value = std::strtoul(text, &end, 10);
+            return end != text && *end == '\0' && value <= kWorkerSpins ? static_cast<unsigned>(value) : kWorkerSpins;
+        }();
+        return spins;
+    }
