GT patch 0048: the GPU path drops the half-pixel offset GT adds to its 3D projection on every other frame (temporal
anti-aliasing the PSP LCD blended; a side-to-side wobble on a modern screen). [Rendering] KeepTemporalJitter=true keeps it.

--- a/lcs/host/ge_renderer.cpp
+++ b/lcs/host/ge_renderer.cpp
@@ -734,6 +734,22 @@
     return result;
 }
 
+// GT patch 0048: GT adds a half-pixel offset to its 3D projection on every other frame (P[8] = 1/480, P[9] = 1/272,
+// the next frame 0: measured on the race route, 2026-10-16), anti-aliasing that the PSP's slow LCD blended into one
+// picture. On a modern screen the whole scene jumps half a pixel back and forth, at x4 two pixels. The GPU path drops
+// exactly that offset unless [Rendering] KeepTemporalJitter=true (the GPU gate keeps it, to compare with the software
+// renderer, which always draws it).
+std::array<float, 16> projection_without_temporal_jitter(const std::array<float, 16> &projection) noexcept {
+    std::array<float, 16> p = projection;
+    if (rendering_keep_temporal_jitter() || p[11] == 0.0f) return p;
+    const auto half_pixel = [](float value, float pixels) {
+        return std::fabs(std::fabs(value) - 1.0f / pixels) <= 1.0e-6f;
+    };
+    if (half_pixel(p[8], 480.0f) && (half_pixel(p[9], 272.0f) || p[9] == 0.0f)) p[8] = 0.0f;
+    if (half_pixel(p[9], 272.0f) && p[8] == 0.0f) p[9] = 0.0f;
+    return p;
+}
