+Layout layout(const HostSettingsView &view) noexcept {
+    Layout l{};
+    l.header_h = kHeaderHeight;
+    l.message_y = view.message[0] != '\0' ? l.header_h + 8 : 0;
+    l.rows_y = (l.message_y != 0 ? l.message_y + kMessageHeight : l.header_h) + 8;
+    const int rows = std::clamp(view.row_count, 0, kViewRows);
+    l.footer_y = l.rows_y + rows * kRowHeight + 8;
+    l.height = l.footer_y + kFooterHeight;
+    return l;
+}
