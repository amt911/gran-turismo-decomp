+// GT patch 0069: the host UI's look. See lcs_host_style.hpp.
+#include "lcs_host_style.hpp"
+
+#define STB_TRUETYPE_IMPLEMENTATION
+#define STBTT_STATIC
+#include "stb_truetype.h"
+
+#include <algorithm>
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#ifndef GT_UI_FONT_DIR
+#define GT_UI_FONT_DIR ""
+#endif
+
+namespace lcs {
+
+namespace {
+
+using host_style::Rgb;
+
+enum FontId { kFontBody = 0, kFontMedium, kFontCondSemi, kFontCondBold, kFontCount };
+constexpr const char *kFontFiles[kFontCount] = {"Barlow-Regular.ttf", "Barlow-Medium.ttf", "BarlowCondensed-SemiBold.ttf",
+                                                "BarlowCondensed-Bold.ttf"};
+
+struct Font {
+    std::vector<unsigned char> data;
+    stbtt_fontinfo info{};
+};
+
+struct Glyph {
+    int w = 0, h = 0, xoff = 0, yoff = 0;
+    float advance = 0.0f;
+    std::vector<unsigned char> bitmap;
+};
+
+struct Style {
+    std::mutex mutex;
+    std::string dir_override;
+    bool dir_set = false;
+    bool tried = false, ok = false;
+    Font fonts[kFontCount];
+    std::unordered_map<std::uint64_t, Glyph> glyphs;
+    // The last rasterization: the view as a canonical byte string (fields one by one, strings up to their NUL, so padding and
+    // bytes after a terminator cannot defeat the comparison), the size, and the pixels.
+    std::string cache_key;
+    std::vector<std::uint8_t> cache_pixels;
+    unsigned long rasterized = 0;
+};
+
+Style &style() {
+    static Style s;
+    return s;
+}
+
+std::string font_dir(const Style &s) {
+    if (s.dir_set) return s.dir_override;
+    if (const char *env = std::getenv("GT_UI_FONT_DIR"); env != nullptr && *env != '\0') return env;
+    return GT_UI_FONT_DIR;
+}
+
+bool read_file(const std::string &path, std::vector<unsigned char> &out) {
+    std::FILE *file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) return false;
+    std::fseek(file, 0, SEEK_END);
+    const long size = std::ftell(file);
+    std::fseek(file, 0, SEEK_SET);
+    bool ok = size > 0;
+    if (ok) {
+        out.resize(static_cast<std::size_t>(size));
+        ok = std::fread(out.data(), 1, out.size(), file) == out.size();
+    }
+    std::fclose(file);
+    return ok;
+}
+
+// Loads the four fonts once (caller holds the mutex). A missing or broken file means no styled UI, logged once.
+bool ensure_fonts(Style &s) {
+    if (s.tried) return s.ok;
+    s.tried = true;
+    const std::string dir = font_dir(s);
+    s.ok = !dir.empty();
+    for (int i = 0; s.ok && i < kFontCount; ++i) {
+        Font &f = s.fonts[i];
+        f = Font{};
+        s.ok = read_file(dir + "/" + kFontFiles[i], f.data) &&
+               stbtt_InitFont(&f.info, f.data.data(), stbtt_GetFontOffsetForIndex(f.data.data(), 0)) != 0;
+    }
+    if (!s.ok) std::fprintf(stderr, "[lcs] host UI font not found in '%s' (tools/setup.sh fetches it); using the 5x7 font\n", dir.c_str());
+    return s.ok;
+}
+
+const Glyph &glyph(Style &s, FontId font, int px, std::uint32_t cp) {
+    const std::uint64_t key = (static_cast<std::uint64_t>(font) << 56) | (static_cast<std::uint64_t>(px) << 32) | cp;
+    auto [it, inserted] = s.glyphs.try_emplace(key);
+    if (!inserted) return it->second;
+    Glyph &g = it->second;
+    const stbtt_fontinfo &info = s.fonts[font].info;
+    int index = stbtt_FindGlyphIndex(&info, static_cast<int>(cp));
+    if (index == 0 && cp != '?') index = stbtt_FindGlyphIndex(&info, '?');
+    const float scale = stbtt_ScaleForMappingEmToPixels(&info, static_cast<float>(px));
+    int advance = 0, bearing = 0;
+    stbtt_GetGlyphHMetrics(&info, index, &advance, &bearing);
+    g.advance = static_cast<float>(advance) * scale;
+    int x0, y0, x1, y1;
+    stbtt_GetGlyphBitmapBox(&info, index, scale, scale, &x0, &y0, &x1, &y1);
+    g.w = x1 - x0;
+    g.h = y1 - y0;
+    g.xoff = x0;
+    g.yoff = y0;
+    if (g.w > 0 && g.h > 0) {
+        g.bitmap.assign(static_cast<std::size_t>(g.w) * g.h, 0);
+        stbtt_MakeGlyphBitmap(&info, g.bitmap.data(), g.w, g.h, g.w, scale, scale, index);
+    }
+    return g;
+}
+
+std::uint32_t next_codepoint(const char *&p) {
+    const unsigned char c = static_cast<unsigned char>(*p++);
+    if (c < 0x80) return c;
+    int extra = c >= 0xF0 ? 3 : c >= 0xE0 ? 2 : 1;
+    std::uint32_t cp = c & (0x3F >> extra);
+    while (extra-- > 0 && (static_cast<unsigned char>(*p) & 0xC0) == 0x80) cp = (cp << 6) | (static_cast<unsigned char>(*p++) & 0x3F);
+    return cp;
+}
+
+// Straight-alpha pixels; every coordinate the drawing functions take is in logical units.
+struct Canvas {
+    std::uint8_t *rgba;
+    int w, h;
+    Style &style;
+
+    void blend(int x, int y, Rgb c, float alpha) const {
+        if (x < 0 || y < 0 || x >= w || y >= h || alpha <= 0.0f) return;
+        alpha = std::min(alpha, 1.0f);
+        std::uint8_t *p = rgba + (static_cast<std::size_t>(y) * w + x) * 4u;
+        const float da = p[3] / 255.0f;
+        const float oa = alpha + da * (1.0f - alpha);
+        const float sr = c.r * alpha + p[0] * da * (1.0f - alpha);
+        const float sg = c.g * alpha + p[1] * da * (1.0f - alpha);
+        const float sb = c.b * alpha + p[2] * da * (1.0f - alpha);
+        p[0] = static_cast<std::uint8_t>(sr / oa + 0.5f);
+        p[1] = static_cast<std::uint8_t>(sg / oa + 0.5f);
+        p[2] = static_cast<std::uint8_t>(sb / oa + 0.5f);
+        p[3] = static_cast<std::uint8_t>(oa * 255.0f + 0.5f);
+    }
+
+    static float box_distance(float px, float py, float cx, float cy, float hx, float hy, float r) {
+        const float qx = std::fabs(px - cx) - (hx - r), qy = std::fabs(py - cy) - (hy - r);
+        return std::hypot(std::max(qx, 0.0f), std::max(qy, 0.0f)) + std::min(std::max(qx, qy), 0.0f) - r;
+    }
+
+    // A rounded rectangle, filled (thickness 0) or as an inner outline of `thickness` logical units.
+    void rrect(float x0, float y0, float x1, float y1, float radius, Rgb c, float alpha, float thickness = 0.0f) const {
+        const float S = host_style::kScale;
+        const float px0 = x0 * S, py0 = y0 * S, px1 = x1 * S, py1 = y1 * S, r = std::min(radius * S, std::min(px1 - px0, py1 - py0) * 0.5f);
+        const float t = thickness * S;
+        const float cx = (px0 + px1) * 0.5f, cy = (py0 + py1) * 0.5f, hx = (px1 - px0) * 0.5f, hy = (py1 - py0) * 0.5f;
+        const int ix0 = std::max(0, static_cast<int>(std::floor(px0))), iy0 = std::max(0, static_cast<int>(std::floor(py0)));
+        const int ix1 = std::min(w, static_cast<int>(std::ceil(px1))), iy1 = std::min(h, static_cast<int>(std::ceil(py1)));
+        for (int y = iy0; y < iy1; ++y) {
+            for (int x = ix0; x < ix1; ++x) {
+                const float fx = x + 0.5f, fy = y + 0.5f;
+                if (t > 0.0f && fx > px0 + t + 1.0f && fx < px1 - t - 1.0f && fy > py0 + t + 1.0f && fy < py1 - t - 1.0f) continue;
+                float cov;
+                if (r <= 0.0f || (fx >= px0 + r && fx < px1 - r) || (fy >= py0 + r && fy < py1 - r)) {
+                    cov = 1.0f;
+                } else {
+                    cov = std::clamp(0.5f - box_distance(fx, fy, cx, cy, hx, hy, r), 0.0f, 1.0f);
+                }
+                if (t > 0.0f) {
+                    const float d = box_distance(fx, fy, cx, cy, hx, hy, r);
+                    cov = std::clamp(0.5f - d, 0.0f, 1.0f) * std::clamp(d + t + 0.5f, 0.0f, 1.0f);
+                }
+                blend(x, y, c, cov * alpha);
+            }
+        }
+    }
+    void rect(float x0, float y0, float x1, float y1, Rgb c, float alpha) const { rrect(x0, y0, x1, y1, 0.0f, c, alpha); }
+
+    // A line segment of `width` logical units with round caps.
+    void line(float x0, float y0, float x1, float y1, float width, Rgb c, float alpha = 1.0f) const {
+        const float S = host_style::kScale;
+        const float ax = x0 * S, ay = y0 * S, bx = x1 * S, by = y1 * S, half = width * S * 0.5f;
+        const int ix0 = std::max(0, static_cast<int>(std::floor(std::min(ax, bx) - half - 1))), ix1 = std::min(w, static_cast<int>(std::ceil(std::max(ax, bx) + half + 1)));
+        const int iy0 = std::max(0, static_cast<int>(std::floor(std::min(ay, by) - half - 1))), iy1 = std::min(h, static_cast<int>(std::ceil(std::max(ay, by) + half + 1)));
+        const float dx = bx - ax, dy = by - ay, len2 = dx * dx + dy * dy;
+        for (int y = iy0; y < iy1; ++y)
+            for (int x = ix0; x < ix1; ++x) {
+                const float fx = x + 0.5f - ax, fy = y + 0.5f - ay;
+                const float u = len2 > 0.0f ? std::clamp((fx * dx + fy * dy) / len2, 0.0f, 1.0f) : 0.0f;
+                const float d = std::hypot(fx - u * dx, fy - u * dy) - half;
+                blend(x, y, c, std::clamp(0.5f - d, 0.0f, 1.0f) * alpha);
+            }
+    }
+
+    void circle(float cx, float cy, float radius, Rgb c, float alpha, float ring = 0.0f) const {
+        rrect(cx - radius, cy - radius, cx + radius, cy + radius, radius, c, alpha, ring);
+    }
+
+    float text_width(FontId font, float size, const char *text, float spacing = 0.0f) const {
+        const int px = std::max(1, static_cast<int>(std::lround(size * host_style::kScale)));
+        float width = 0.0f;
+        for (const char *p = text; *p != '\0';) width += glyph(style, font, px, next_codepoint(p)).advance / host_style::kScale + spacing;
+        return width > 0.0f ? width - spacing : 0.0f;
+    }
+
+    // `text` cut (with an ellipsis) to at most `max_width` logical units.
+    std::string fit(FontId font, float size, const char *text, float max_width, float spacing = 0.0f) const {
+        std::string out = text;
+        if (text_width(font, size, text, spacing) <= max_width) return out;
+        while (!out.empty()) {
+            do out.pop_back(); while (!out.empty() && (static_cast<unsigned char>(out.back()) & 0xC0) == 0x80);
+            const std::string cut = out + "\xE2\x80\xA6";
+            if (text_width(font, size, cut.c_str(), spacing) <= max_width) return cut;
+        }
+        return out;
+    }
+
+    // Draws `text` with its baseline at y; returns its width. align: 0 left, 1 right of x, 2 centred on x.
+    float text(FontId font, float size, float x, float y, const char *text, Rgb c, float alpha = 1.0f, float spacing = 0.0f,
+               int align = 0) const {
+        const float width = text_width(font, size, text, spacing);
+        float pen = (align == 1 ? x - width : align == 2 ? x - width * 0.5f : x) * host_style::kScale;
+        const int px = std::max(1, static_cast<int>(std::lround(size * host_style::kScale)));
+        const int baseline = static_cast<int>(std::lround(y * host_style::kScale));
+        for (const char *p = text; *p != '\0';) {
+            const Glyph &g = glyph(style, font, px, next_codepoint(p));
+            const int gx = static_cast<int>(std::lround(pen)) + g.xoff, gy = baseline + g.yoff;
+            for (int row = 0; row < g.h; ++row)
+                for (int col = 0; col < g.w; ++col) {
+                    const unsigned char cov = g.bitmap[static_cast<std::size_t>(row) * g.w + col];
+                    if (cov != 0u) blend(gx + col, gy + row, c, cov / 255.0f * alpha);
+                }
+            pen += g.advance + spacing * host_style::kScale;
+        }
+        return width;
+    }
+};
+
+constexpr Rgb kWhite{255, 255, 255}, kText2{201, 209, 224}, kText3{154, 166, 189};
+
+// ---- rows derived from text (the F10 page and any host page without structured rows) --------------------------------------
+
+bool iequals(const char *a, const char *b) {
+    for (; *a != '\0' && *b != '\0'; ++a, ++b)
+        if (std::tolower(static_cast<unsigned char>(*a)) != std::tolower(static_cast<unsigned char>(*b))) return false;
+    return *a == *b;
+}
+
+void derive_row(const char *text, HostViewRow &out) {
+    out = HostViewRow{};
+    const std::string row = text;
+    std::size_t gap = std::string::npos;
+    const std::size_t first = row.find_first_not_of(' ');
+    for (std::size_t i = first == std::string::npos ? 0 : first; i + 1 < row.size(); ++i)
+        if (row[i] == ' ' && row[i + 1] == ' ') {
+            gap = i;
+            break;
+        }
+    std::string label = gap == std::string::npos ? row : row.substr(0, gap);
+    std::string value = gap == std::string::npos ? "" : row.substr(row.find_first_not_of(' ', gap) == std::string::npos ? row.size() : row.find_first_not_of(' ', gap));
+    while (!value.empty() && value.back() == ' ') value.pop_back();
+    while (!label.empty() && label.back() == ' ') label.pop_back();
+    std::snprintf(out.label, sizeof out.label, "%s", label.c_str());
+    if (iequals(value.c_str(), "ON") || iequals(value.c_str(), "OFF")) {
+        out.kind = HostRowKind::Toggle;
+        out.on = iequals(value.c_str(), "ON");
+    } else if (value.rfind("ERROR", 0) == 0) {
+        out.kind = HostRowKind::Pill;
+        out.tone = HostPillTone::Red;
+        std::snprintf(out.value, sizeof out.value, "ERROR");
+        if (value.size() > 6) std::snprintf(out.hint, sizeof out.hint, "%s", value.c_str() + 6);
+    } else if (!value.empty()) {
+        out.kind = HostRowKind::Choice;
+        std::snprintf(out.value, sizeof out.value, "%s", value.c_str());
+    }
+}
+
+// ---- drawing -------------------------------------------------------------------------------------------------------------
+
+void draw_icon(const Canvas &c, int which, float x, float cy) {  // 18 x 18; 0 cross, 1 circle, 2 left / right
+    const float r = 9.0f;
+    const Rgb tone = which == 0 ? host_style::kBlue : which == 1 ? host_style::kRed : host_style::kGrey;
+    c.circle(x + r, cy, r, tone, 1.0f);
+    const float m = x + r;
+    if (which == 0) {
+        c.line(m - 3.2f, cy - 3.2f, m + 3.2f, cy + 3.2f, 1.7f, kWhite);
+        c.line(m - 3.2f, cy + 3.2f, m + 3.2f, cy - 3.2f, 1.7f, kWhite);
+    } else if (which == 1) {
+        c.circle(m, cy, 3.9f, kWhite, 1.0f, 1.7f);
+    } else {
+        c.line(m - 1.5f, cy - 3.4f, m - 4.6f, cy, 1.6f, kWhite);
+        c.line(m - 4.6f, cy, m - 1.5f, cy + 3.4f, 1.6f, kWhite);
+        c.line(m + 1.5f, cy - 3.4f, m + 4.6f, cy, 1.6f, kWhite);
+        c.line(m + 4.6f, cy, m + 1.5f, cy + 3.4f, 1.6f, kWhite);
+    }
+}
+
+void draw_row_value(const Canvas &c, const HostViewRow &row, float top, bool selected) {
+    using namespace host_style;
+    const float right = kPanelWidth - 26.0f, cy = top + kRowHeight * 0.5f, base = cy + 5.0f;
+    switch (row.kind) {
+    case HostRowKind::Toggle: {
+        const float w = 46.0f, h = 22.0f;
+        c.rrect(right - w, cy - h * 0.5f, right, cy + h * 0.5f, h * 0.5f, row.on ? kGreen : kGrey, 1.0f);
+        c.text(kFontCondBold, 12.5f, right - w * 0.5f, cy + 4.3f, row.on ? "ON" : "OFF", row.on ? kBody : kText2, 1.0f, 0.8f, 2);
+        break;
+    }
+    case HostRowKind::Pill: {
+        const Rgb tone = row.tone == HostPillTone::Green ? kGreen : row.tone == HostPillTone::Amber ? kAmber
+                         : row.tone == HostPillTone::Red ? kRed : kGrey;
+        const float w = c.text_width(kFontCondBold, 12.5f, row.value, 0.8f) + 22.0f, h = 22.0f;
+        c.rrect(right - w, cy - h * 0.5f, right, cy + h * 0.5f, h * 0.5f, tone, 1.0f);
+        c.text(kFontCondBold, 12.5f, right - w * 0.5f, cy + 4.3f, row.value, row.tone == HostPillTone::Red || row.tone == HostPillTone::Grey ? kWhite : kBody, 1.0f, 0.8f, 2);
+        break;
+    }
+    case HostRowKind::Choice: {
+        const Rgb arrow = selected ? kBlue : kGrey;
+        c.text(kFontMedium, 18.0f, right, base + 1.0f, "\xE2\x80\xBA", arrow, 1.0f, 0.0f, 1);
+        const float vr = right - 14.0f;
+        const float vw = c.text(kFontMedium, 16.5f, vr, base, row.value, selected ? kWhite : kText2, 1.0f, 0.0f, 1);
+        c.text(kFontMedium, 18.0f, vr - vw - 8.0f, base + 1.0f, "\xE2\x80\xB9", arrow, 1.0f, 0.0f, 1);
+        break;
+    }
+    case HostRowKind::Percent: {
+        const float tw = c.text(kFontMedium, 16.0f, right, base, row.value, selected ? kWhite : kText2, 1.0f, 0.0f, 1);
+        const float bar_w = 84.0f, bx1 = right - tw - 12.0f, bx0 = bx1 - bar_w;
+        c.rrect(bx0, cy - 3.0f, bx1, cy + 3.0f, 3.0f, kGrey, 1.0f);
+        const float fill = bar_w * std::clamp(row.percent, 0, 100) / 100.0f;
+        if (fill > 0.5f) c.rrect(bx0, cy - 3.0f, bx0 + std::max(fill, 6.0f), cy + 3.0f, 3.0f, kBlue, 1.0f);
+        break;
+    }
+    case HostRowKind::Chip: {
+        const bool capture = std::strncmp(row.value, "Press", 5) == 0 || std::strncmp(row.value, "PRESS", 5) == 0;
+        const float w = c.text_width(kFontCondSemi, 14.0f, row.value, 0.6f) + 22.0f, h = 24.0f;
+        if (capture) c.rrect(right - w, cy - h * 0.5f, right, cy + h * 0.5f, 7.0f, kBlue, 0.28f);
+        else c.rrect(right - w, cy - h * 0.5f, right, cy + h * 0.5f, 7.0f, kWhite, 0.07f);
+        c.rrect(right - w, cy - h * 0.5f, right, cy + h * 0.5f, 7.0f, capture ? kBlue : kText3, capture ? 1.0f : 0.6f, 1.0f);
+        c.text(kFontCondSemi, 14.0f, right - w * 0.5f, cy + 4.8f, row.value, selected || capture ? kWhite : kText2, 1.0f, 0.6f, 2);
+        break;
+    }
+    case HostRowKind::Submenu:
+        c.text(kFontMedium, 22.0f, right, base + 2.0f, "\xE2\x80\xBA", selected ? kBlue : kText3, 1.0f, 0.0f, 1);
+        break;
+    case HostRowKind::Text:
+        c.text(kFontMedium, 16.0f, right, base, row.value, selected ? kWhite : kText3, 1.0f, 0.0f, 1);
+        break;
+    }
+}
