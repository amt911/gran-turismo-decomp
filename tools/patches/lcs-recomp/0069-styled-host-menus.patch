+bool host_style_font_available() noexcept {
+    Style &s = style();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    return ensure_fonts(s);
+}
+
+bool host_style_rasterize(const HostSettingsView &view, std::uint8_t *rgba, std::uint32_t width, std::uint32_t height) noexcept {
+    using namespace host_style;
+    Style &s = style();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    if (!ensure_fonts(s)) return false;
+    const std::size_t bytes = static_cast<std::size_t>(width) * height * 4u;
+    std::string key = view_key(view, width, height);
+    if (key == s.cache_key && s.cache_pixels.size() == bytes) {  // the same picture as last frame
+        std::memcpy(rgba, s.cache_pixels.data(), bytes);
+        return true;
+    }
+    ++s.rasterized;
+    std::memset(rgba, 0, bytes);
+    const Canvas c{rgba, static_cast<int>(width), static_cast<int>(height), s};
+    const Layout l = layout(view);
+    const float W = kPanelWidth, H = static_cast<float>(l.height);
+
+    // frame
+    c.rrect(0, 0, W, H, 14.0f, kBody, 0.88f);
+    c.rrect(0, 0, W, H, 14.0f, kWhite, 0.16f, 1.0f);
+
+    // header: title, position, breadcrumb or tabs, underline
+    c.text(kFontCondBold, 23.0f, kPad, 30.0f, view.title, kWhite, 1.0f, 2.2f);
+    if (view.count > 0) {
+        char position[24];
+        std::snprintf(position, sizeof position, "%d / %d", view.position, view.count);
+        c.text(kFontMedium, 14.0f, W - kPad, 30.0f, position, kText3, 1.0f, 0.0f, 1);
+    }
+    if (view.tabs) {
+        const char *names[2] = {"SETTINGS", "MODS"};
+        float x = kPad;
+        for (int i = 0; i < 2; ++i)
+            x += c.text(kFontCondSemi, 14.5f, x, 50.0f, names[i], i == view.tab ? kBlue : kText3, 1.0f, 1.6f) + 22.0f;
+    } else if (view.crumb[0] != '\0') {
+        std::string crumb = view.crumb;
+        std::vector<std::string> parts;
+        for (std::size_t at = 0;;) {
+            const std::size_t sep = crumb.find(" > ", at);
+            parts.push_back(crumb.substr(at, sep == std::string::npos ? std::string::npos : sep - at));
+            if (sep == std::string::npos) break;
+            at = sep + 3;
+        }
+        float x = kPad;
+        for (std::size_t i = 0; i < parts.size(); ++i) {
+            const bool last = i + 1 == parts.size();
+            x += c.text(kFontMedium, 14.5f, x, 50.0f, parts[i].c_str(), last ? kBlue : kText3);
+            if (!last) x += 6.0f + c.text(kFontMedium, 14.5f, x + 6.0f, 50.0f, "\xE2\x80\xBA", kText3) + 6.0f;
+        }
+    }
+    c.rect(kPad, static_cast<float>(l.header_h - 2), W - kPad, static_cast<float>(l.header_h), kBlue, 1.0f);
+
+    // message box
+    if (l.message_y != 0) {
+        const Rgb tone = view.message_is_error ? kRed : kBlue;
+        const float y0 = static_cast<float>(l.message_y), y1 = y0 + kMessageHeight;
+        c.rrect(14.0f, y0, W - 14.0f, y1, 9.0f, tone, 0.2f);
+        c.rrect(14.0f, y0, W - 14.0f, y1, 9.0f, tone, 1.0f, 1.0f);
+        c.circle(32.0f, y0 + kMessageHeight * 0.5f, 7.5f, tone, 1.0f);
+        c.text(kFontCondBold, 12.0f, 32.0f, y0 + kMessageHeight * 0.5f + 4.2f, view.message_is_error ? "!" : "i", kWhite, 1.0f, 0.0f, 2);
+        c.text(kFontMedium, 15.0f, 48.0f, y0 + kMessageHeight * 0.5f + 5.2f, c.fit(kFontMedium, 15.0f, view.message, W - 48.0f - 26.0f).c_str(), kWhite);
+    }
+
+    // rows
+    for (int i = 0; i < std::clamp(view.row_count, 0, kViewRows); ++i) {
+        HostViewRow derived;
+        if (!view.styled) derive_row(view.rows[i], derived);
+        const HostViewRow &row = view.styled ? view.items[i] : derived;
+        const float top = static_cast<float>(l.rows_y + i * kRowHeight);
+        const bool selected = i == view.selected;
+        if (selected) {
+            c.rrect(10.0f, top + 2.0f, W - 10.0f, top + kRowHeight - 2.0f, 9.0f, kBlue, 0.22f);
+            c.rrect(10.0f, top + 7.0f, 14.0f, top + kRowHeight - 7.0f, 2.0f, kBlue, 1.0f);
+        }
+        const float cy = top + kRowHeight * 0.5f;
+        const bool hint = row.hint[0] != '\0';
+        c.text(kFontMedium, 17.0f, 28.0f, hint ? cy - 1.5f : cy + 6.0f, c.fit(kFontMedium, 17.0f, row.label, 300.0f).c_str(), selected ? kWhite : kText2);
+        if (hint) c.text(kFontBody, 12.0f, 28.0f, cy + 14.0f, c.fit(kFontBody, 12.0f, row.hint, 300.0f).c_str(), kText3);
+        draw_row_value(c, row, top, selected);
+    }
+
+    // footer
+    const float fy = static_cast<float>(l.footer_y), fc = fy + kFooterHeight * 0.5f;
+    c.rect(kPad, fy, W - kPad, fy + 1.0f, kWhite, 0.10f);
+    if (view.capturing) {
+        c.text(kFontMedium, 15.0f, kPad, fc + 5.0f, "Press the new combination", kWhite);
+        const float tw = c.text(kFontBody, 14.0f, W - kPad, fc + 5.0f, "hold to cancel", kText2, 1.0f, 0.0f, 1);
+        draw_icon(c, 1, W - kPad - tw - 26.0f, fc);
+    } else if (view.panel) {
+        float x = kPad;
+        const char *labels[3] = {"Select", "Back", "Change"};
+        for (int i = 0; i < 3; ++i) {
+            draw_icon(c, i, x, fc);
+            x += 18.0f + 7.0f + c.text(kFontBody, 14.0f, x + 25.0f, fc + 5.0f, labels[i], kText2) + 16.0f;
+        }
+        if (view.binding[0] != '\0') c.text(kFontCondSemi, 13.0f, W - kPad, fc + 4.6f, view.binding, kText3, 1.0f, 0.6f, 1);
+    } else {
+        c.text(kFontCondSemi, 13.0f, kPad, fc + 4.6f, view.footer, kText3, 1.0f, 0.6f);
+        if (view.resolution_pending) c.text(kFontCondSemi, 13.0f, W - kPad, fc + 4.6f, "RESTART TO APPLY", kAmber, 1.0f, 0.6f, 1);
+    }
+    s.cache_pixels.assign(rgba, rgba + bytes);
+    s.cache_key = std::move(key);
+    return true;
+}
+
+}  // namespace lcs
