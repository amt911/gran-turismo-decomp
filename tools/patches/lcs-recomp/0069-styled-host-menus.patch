+// The basic look is laid out for 512 x 256; the 2x texture gets it doubled.
+void rasterize_fallback(const HostSettingsView &view_in, std::uint8_t *rgba, std::uint32_t width, std::uint32_t height) noexcept {
+    HostSettingsView view = view_in;
+    if (view.styled && view.panel)  // the old look had the path (or the refusal) as its title
+        std::snprintf(view.title, sizeof view.title, "%.31s", view.message[0] != '\0' ? view.message : view.crumb);
+    constexpr std::uint32_t bw = 512u, bh = 256u;
+    if (width < bw * 2u || height < bh * 2u) {
+        rasterize_basic(view, rgba, width, height);
+        return;
+    }
+    std::vector<std::uint8_t> small(static_cast<std::size_t>(bw) * bh * 4u);
+    rasterize_basic(view, small.data(), bw, bh);
+    std::memset(rgba, 0, static_cast<std::size_t>(width) * height * 4u);
+    for (std::uint32_t y = 0; y < bh * 2u; ++y)
+        for (std::uint32_t x = 0; x < bw * 2u; ++x)
+            std::memcpy(rgba + (static_cast<std::size_t>(y) * width + x) * 4u,
+                        small.data() + (static_cast<std::size_t>(y / 2u) * bw + x / 2u) * 4u, 4u);
+}
+
+}  // namespace
+
