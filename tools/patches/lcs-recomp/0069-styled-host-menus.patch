+// ---- GT patch 0069: the styled look -------------------------------------------------------------------------------------------
+
+lcs::HostViewRow styled_row(lcs::HostRowKind kind, const char *label, const char *value = "", bool on = false, int percent = 0) {
+    lcs::HostViewRow row{};
+    row.kind = kind;
+    row.on = on;
+    row.percent = percent;
+    std::snprintf(row.label, sizeof row.label, "%s", label);
+    std::snprintf(row.value, sizeof row.value, "%s", value);
+    return row;
+}
+
+struct Raster {
+    std::vector<std::uint8_t> rgba = std::vector<std::uint8_t>(static_cast<std::size_t>(lcs::kSettingsOverlayWidth) * lcs::kSettingsOverlayHeight * 4u);
+    explicit Raster(const lcs::HostSettingsView &view) {
+        lcs::rasterize_settings_overlay(view, rgba.data(), lcs::kSettingsOverlayWidth, lcs::kSettingsOverlayHeight);
+    }
+    // A pixel at logical coordinates (the layout is 2x).
+    const std::uint8_t *at(float x, float y) const {
+        return &rgba[(static_cast<std::size_t>(y * lcs::host_style::kScale) * lcs::kSettingsOverlayWidth +
+                      static_cast<std::size_t>(x * lcs::host_style::kScale)) * 4u];
+    }
+    static bool is(const std::uint8_t *p, lcs::host_style::Rgb c) { return p[0] == c.r && p[1] == c.g && p[2] == c.b && p[3] == 255u; }
+};
+
+lcs::HostSettingsView device_like_view() {
+    using namespace lcs;
+    HostSettingsView view{};
+    view.panel = true;
+    view.styled = true;
+    std::snprintf(view.title, sizeof view.title, "CHEAT DEVICE");
+    std::snprintf(view.crumb, sizeof view.crumb, "Cheats > Race");
+    std::snprintf(view.binding, sizeof view.binding, "SELECT + START | F7");
+    view.position = 3;
+    view.count = 6;
+    view.row_count = 4;
+    view.selected = 1;
+    view.items[0] = styled_row(HostRowKind::Toggle, "Slow motion", "", true);
+    view.items[1] = styled_row(HostRowKind::Toggle, "Ghost cars", "", false);
+    view.items[2] = styled_row(HostRowKind::Percent, "Grip", "70%", false, 70);
+    view.items[3] = styled_row(HostRowKind::Choice, "Weather", "Rain");
+    return view;
+}
+
+int styled() {
+    using namespace lcs;
+    // The palette is pinned here as literals (the game's blue, the pill colours): changing a colour in the style must fail this test.
+    constexpr host_style::Rgb kBlue{47, 127, 232}, kGreen{46, 179, 113}, kGrey{74, 82, 100};
+    if (!host_style_font_available()) return fail("the UI font (tools/setup.sh fetches Barlow) is not available");
+    HostSettingsView view = device_like_view();
+    const host_style::Layout where = host_style::layout(view);
+    const auto start = std::chrono::steady_clock::now();
+    Raster r(view);
+    const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    if (!Raster::is(r.at(100.0f, static_cast<float>(where.header_h) - 1.0f), kBlue)) return fail("header underline is blue");
+    if (!Raster::is(r.at(12.0f, static_cast<float>(where.rows_y + host_style::kRowHeight + 22)), kBlue)) return fail("selected row's left bar is blue");
+    if (Raster::is(r.at(12.0f, static_cast<float>(where.rows_y + 22)), kBlue)) return fail("an unselected row has no bar");
+    const float right = host_style::kPanelWidth - 26.0f;
+    if (!Raster::is(r.at(right - 44.0f, static_cast<float>(where.rows_y + 22)), kGreen)) return fail("ON pill is green");
+    if (!Raster::is(r.at(right - 44.0f, static_cast<float>(where.rows_y + host_style::kRowHeight + 22)), kGrey)) return fail("OFF pill is grey");
+    if (!Raster::is(r.at(right - 100.0f, static_cast<float>(where.rows_y + 2 * host_style::kRowHeight + 22)), kBlue)) return fail("the percentage bar's fill is blue");
+    // The cache: an identical view is copied, not rasterized again; a changed row is.
+    {
+        HostSettingsView same = view;
+        Raster a(same);
+        const unsigned long first = host_style_raster_count();
+        Raster b(same);
+        if (host_style_raster_count() != first) return fail("an identical view was rasterized again");
+        if (a.rgba != b.rgba) return fail("the cached picture differs from the rasterized one");
+        std::vector<std::uint8_t> frame(a.rgba.size());
+        const auto t0 = std::chrono::steady_clock::now();
+        for (int i = 0; i < 50; ++i) rasterize_settings_overlay(same, frame.data(), kSettingsOverlayWidth, kSettingsOverlayHeight);
+        const double cached_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() / 50.0;
+        if (host_style_raster_count() != first) return fail("identical frames were rasterized again");
+        HostSettingsView flip = same;
+        const auto t1 = std::chrono::steady_clock::now();
+        for (int i = 0; i < 20; ++i) {
+            flip.selected = (i % 2) ? 0 : 2;  // never equal to `same` (1) or to the previous frame
+            rasterize_settings_overlay(flip, frame.data(), kSettingsOverlayWidth, kSettingsOverlayHeight);
+        }
+        const double changed_ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t1).count() / 20.0;
+        if (host_style_raster_count() != first + 20) return fail("changed views were not all rasterized");
+        const unsigned long base = host_style_raster_count();
+        Raster back(same);  // back to the first view: rasterized again (the cache holds one picture), and equal to it
+        if (host_style_raster_count() != base + 1 || back.rgba != a.rgba) return fail("returning to the first view");
+        same.items[0].on = false;  // a changed row
+        Raster c(same);
+        if (host_style_raster_count() != base + 2) return fail("a changed row was not rasterized");
+        if (c.rgba == a.rgba) return fail("the changed row shows");
+        same.items[3].hint[0] = 'h';  // every field is part of the key: a hint alone
+        Raster e(same);
+        if (host_style_raster_count() != base + 3) return fail("a changed hint was not rasterized");
+        same.items[3].hint[0] = '\0';
+        HostSettingsView tail = same;  // bytes after a string's terminator must not matter
+        tail.items[0].label[sizeof tail.items[0].label - 1] = 'x';
+        Raster d(tail);
+        if (host_style_raster_count() != base + 4) return fail("bytes after a terminator defeated the cache");
+        std::cout << "cache: identical view " << cached_ms << " ms/frame, changed view " << changed_ms << " ms/frame\n";
+    }
+    // The breadcrumb's last segment is blue text: some blue-ish pixels on its line, and the position text is not.
+    int blue_text = 0;
+    for (int y = 40; y < 54; ++y)
+        for (int x = 20; x < 200; ++x) {
+            const std::uint8_t *p = r.at(static_cast<float>(x), static_cast<float>(y));
+            if (p[2] > 200u && p[0] < 120u && p[3] == 255u) ++blue_text;
+        }
+    if (blue_text < 30) return fail("breadcrumb's last segment is drawn in blue");
+    // No message: no red anywhere in the box's band; an error message draws the red box.
+    const auto red_pixels = [&](const Raster &raster, int y0, int y1) {
+        int n = 0;
+        for (int y = y0; y < y1; ++y)
+            for (int x = 20; x < 500; ++x) {
+                const std::uint8_t *p = raster.at(static_cast<float>(x), static_cast<float>(y));
+                if (p[0] > 180u && p[1] < 90u && p[3] > 200u) ++n;
+            }
+        return n;
+    };
+    if (red_pixels(r, 0, 120) != 0) return fail("no red without a refusal");
+    view.message_is_error = true;
+    std::snprintf(view.message, sizeof view.message, "Refused: F7 is already bound");
+    const host_style::Layout with_message = host_style::layout(view);
+    if (with_message.message_y == 0 || with_message.rows_y <= where.rows_y) return fail("the message makes room");
+    Raster refused(view);
+    if (red_pixels(refused, with_message.message_y, with_message.message_y + host_style::kMessageHeight) < 200) return fail("an error message is a red box");
+    view.message_is_error = false;
+    Raster info(view);
+    if (red_pixels(info, with_message.message_y, with_message.message_y + host_style::kMessageHeight) != 0) return fail("a plain message is not red");
+    // Capturing: the red Circle icon in the footer.
+    view.message[0] = '\0';
+    view.capturing = true;
+    Raster capture(view);
+    const host_style::Layout cl = host_style::layout(view);
+    if (red_pixels(capture, cl.footer_y, cl.height) < 100) return fail("the capture footer has the red Circle icon");
+    // A classic page (F10): text rows become pills.
+    HostSettingsView classic{};
+    std::snprintf(classic.title, sizeof classic.title, "SETTINGS");
+    std::snprintf(classic.rows[0], sizeof classic.rows[0], "Fullscreen      On");
+    std::snprintf(classic.rows[1], sizeof classic.rows[1], "FPS counter     Off");
+    std::snprintf(classic.rows[2], sizeof classic.rows[2], "Resolution      960x544 ~540p");
+    classic.row_count = 3;
+    classic.tabs = true;
+    const host_style::Layout kl = host_style::layout(classic);
+    Raster plain(classic);
+    if (!Raster::is(plain.at(right - 44.0f, static_cast<float>(kl.rows_y + 22)), kGreen)) return fail("F10 text row 'On' becomes the green pill");
+    if (!Raster::is(plain.at(right - 44.0f, static_cast<float>(kl.rows_y + host_style::kRowHeight + 22)), kGrey)) return fail("F10 text row 'Off' becomes the grey pill");
+    // The extra page asks for structured rows through `item`.
+    static const HostExtraPage page{"MODS", []() -> std::size_t { return 2u; },
+                                    [](std::size_t, char *out, std::size_t cap) { std::snprintf(out, cap, "text"); },
+                                    [](std::size_t) { return false; }, nullptr, nullptr, nullptr, false,
+                                    [](std::size_t index, HostViewRow &out) {
+                                        out = styled_row(HostRowKind::Pill, index == 0 ? "Alpha" : "Beta", "UPDATE");
+                                        out.tone = HostPillTone::Amber;
+                                        std::snprintf(out.hint, sizeof out.hint, "v1.2");
+                                    }};
+    host_settings_set_extra_page(&page);
+    host_settings_handle(HostSettingsKey::TogglePage);
+    const HostSettingsView mods = host_settings_view();
+    if (!mods.styled || !mods.tabs || mods.tab != 1 || mods.count != 2 || mods.position != 1 || mods.row_count != 2 ||
+        std::string(mods.items[1].label) != "Beta" || std::string(mods.items[0].hint) != "v1.2")
+        return fail("the extra page's structured rows, tab and position");
+    host_settings_handle(HostSettingsKey::Close);
+    host_settings_set_extra_page(nullptr);
+    std::cout << "styled=blue underline, blue bar, green/grey pills, red message box, F10 pills; rasterize " << ms << " ms\n";
+    return 0;
+}
+
+int styled_nofont() {
+    using namespace lcs;
+    host_style_set_font_dir("/nonexistent-ui-font-dir");
+    if (host_style_font_available()) return fail("a missing font directory reports the font");
+    const HostSettingsView view = device_like_view();
+    Raster r(view);
+    // Fallback: the 5x7 look doubled: the amber frame of the panel is in the corner, and text pixels are lit.
+    if (r.at(0.0f, 0.0f)[0] != 236u) return fail("the 5x7 panel frame is drawn");
+    std::size_t lit = 0;
+    for (std::size_t i = 0; i + 3u < r.rgba.size(); i += 4u)
+        if (r.rgba[i + 3u] == 255u && r.rgba[i] > 150u && r.rgba[i + 1u] > 150u) ++lit;
+    if (lit < 40u) return fail("the fallback draws text");
+    std::cout << "styled_nofont=5x7 fallback, no crash\n";
+    return 0;
+}
+
 }  // namespace
 
