+#pragma once
+
+// GT patch 0069: the host UI's look (cheat device panel, F9 MODS, F10 settings): one frame, one palette, Barlow text drawn with
+// stb_truetype, laid out in 520 x 512 logical units and rasterized at 2x. Used by every present path through
+// rasterize_settings_overlay (lcs_display_menu.hpp).
+
+#include "lcs_display_menu.hpp"
+
+#include <cstdint>
+
+namespace lcs {
+
+namespace host_style {
+
+inline constexpr int kScale = 2;       // texture pixels per logical unit
+inline constexpr int kPanelWidth = 520;  // logical
+inline constexpr int kPad = 20;
+inline constexpr int kHeaderHeight = 62;
+inline constexpr int kRowHeight = 44;
+inline constexpr int kFooterHeight = 44;
+inline constexpr int kMessageHeight = 40;  // the message box, plus 8 of gap
+
+struct Rgb {
+    std::uint8_t r, g, b;
+};
+// The game's blue and red, a green / grey / amber for the pills.
+inline constexpr Rgb kBlue{47, 127, 232};
+inline constexpr Rgb kRed{232, 56, 79};
+inline constexpr Rgb kGreen{46, 179, 113};
+inline constexpr Rgb kGrey{74, 82, 100};
+inline constexpr Rgb kAmber{232, 168, 56};
+inline constexpr Rgb kBody{11, 14, 22};
+
+// Where things are, in logical units (tests and the screenshot dump use these to find them).
+struct Layout {
+    int header_h;     // the header's height; its underline is the last 2 units
+    int message_y;    // top of the message box (0 = none)
+    int rows_y;       // top of the first row
+    int footer_y;     // top of the footer
+    int height;       // the panel's height
+};
+[[nodiscard]] Layout layout(const HostSettingsView &view) noexcept;
+
+}  // namespace host_style
+
+// Draws the styled UI into `rgba` (width x height, straight alpha, cleared first). False when the UI font is not available:
+// the caller falls back to the 5x7 look.
+bool host_style_rasterize(const HostSettingsView &view, std::uint8_t *rgba, std::uint32_t width, std::uint32_t height) noexcept;
+
+// Rasterizations actually done (a frame whose view and size equal the last one's is copied from a cache): test hook.
+[[nodiscard]] unsigned long host_style_raster_count() noexcept;
+
+}  // namespace lcs
