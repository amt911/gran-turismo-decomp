+void host_style_set_font_dir(const char *directory) noexcept {
+    Style &s = style();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.dir_override = directory != nullptr ? directory : "";
+    s.dir_set = directory != nullptr;
+    s.tried = false;
+    s.ok = false;
+    s.glyphs.clear();
+    s.cache_key.clear();
+}
