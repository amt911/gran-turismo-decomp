+// GT patch 0069: the host UI is rasterized at 2x (a 520 x 512 layout) so it stays sharp at 1080p.
+inline constexpr std::uint32_t kSettingsOverlayWidth = 1040u;
+inline constexpr std::uint32_t kSettingsOverlayHeight = 1024u;
+// The width the overlay is presented at, top right: 40 % of the output, but never below the 1x layout (520) and never wider
+// than the texture (1040) or the output.
+[[nodiscard]] inline float settings_overlay_present_width(float output_width) noexcept {
+    const float wanted = output_width * 0.40f;
+    const float width = wanted < 520.0f ? 520.0f : (wanted > 1040.0f ? 1040.0f : wanted);
+    const float room = output_width - 48.0f;
+    return width < room ? width : (room > 64.0f ? room : 64.0f);
+}
