+namespace {
+
+std::string view_key(const HostSettingsView &view, std::uint32_t width, std::uint32_t height) {
+    std::string k;
+    const auto put = [&k](const auto &value) { k.append(reinterpret_cast<const char *>(&value), sizeof value); };
+    const auto str = [&k](const char *text, std::size_t capacity) {
+        k.append(text, strnlen(text, capacity));
+        k.push_back('\0');
+    };
+    put(width);
+    put(height);
+    put(view.selected);
+    put(view.row_count);
+    put(view.resolution_pending);
+    put(view.panel);
+    put(view.styled);
+    put(view.position);
+    put(view.count);
+    put(view.message_is_error);
+    put(view.capturing);
+    put(view.tabs);
+    put(view.tab);
+    str(view.title, sizeof view.title);
+    str(view.footer, sizeof view.footer);
+    str(view.crumb, sizeof view.crumb);
+    str(view.message, sizeof view.message);
+    str(view.binding, sizeof view.binding);
+    for (int i = 0; i < kViewRows; ++i) {
+        str(view.rows[i], sizeof view.rows[i]);
+        const HostViewRow &row = view.items[i];
+        put(row.kind);
+        put(row.tone);
+        put(row.on);
+        put(row.percent);
+        str(row.label, sizeof row.label);
+        str(row.value, sizeof row.value);
+        str(row.hint, sizeof row.hint);
+    }
+    return k;
+}
