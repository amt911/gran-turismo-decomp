+// GT patch 0068: the host panel, a second overlay the host program opens and drives itself (GT: the cheat device). It is
+// drawn when the settings overlay is closed and, unlike it, leaves the input alone: the pad still reaches the host (which
+// hides it from the game itself) and only the keyboard's game bindings are held back, so the host can read the keys.
+struct HostPanel {
+    void (*view)(HostSettingsView &view);  // fills title, footer, rows, row_count, selected
+    // The window's navigation keys while the panel is open (arrows, Enter, Escape/Backspace = Close; with the OS key repeat);
+    // false closes the panel.
+    bool (*key)(HostSettingsKey key) = nullptr;
