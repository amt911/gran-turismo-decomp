+// GT patch 0068: the host panel, rasterized like the GPU paths do (one look everywhere) and drawn top right.
+void paint_host_panel(SDL_Renderer *renderer) noexcept {
+    HostSettingsView view{};
+    if (renderer == nullptr || !host_overlay_view(view)) return;
+    static SDL_Renderer *owner = nullptr;
+    static SDL_Texture *texture = nullptr;
+    static std::vector<std::uint8_t> pixels(static_cast<std::size_t>(kSettingsOverlayWidth) * kSettingsOverlayHeight * 4u);
+    if (owner != renderer || texture == nullptr) {
+        if (texture != nullptr && owner == renderer) SDL_DestroyTexture(texture);
+        texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING,
+                                    static_cast<int>(kSettingsOverlayWidth), static_cast<int>(kSettingsOverlayHeight));
+        owner = renderer;
+        if (texture == nullptr) return;
+        SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_BLEND);
+    }
+    rasterize_settings_overlay(view, pixels.data(), kSettingsOverlayWidth, kSettingsOverlayHeight);
+    SDL_UpdateTexture(texture, nullptr, pixels.data(), static_cast<int>(kSettingsOverlayWidth * 4u));
+    int output_w = 960, output_h = 544;
+    SDL_GetRendererOutputSize(renderer, &output_w, &output_h);
+    const int panel_w = std::min(static_cast<int>(static_cast<float>(output_w) * 0.46f), static_cast<int>(kSettingsOverlayWidth));
+    const SDL_Rect destination{output_w - panel_w - 24, 24, panel_w, panel_w / 2};
+    SDL_RenderCopy(renderer, texture, nullptr, &destination);
+}
