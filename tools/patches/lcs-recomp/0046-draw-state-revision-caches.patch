+// GT patch 0046: GT_GE_REVISION_VERIFY=1 rebuilds the cached state on every hit and counts the differences.
+std::atomic<std::uint64_t> g_revision_verify_mismatches{0u};
+bool revision_verify_enabled() noexcept {
+    static const bool enabled = std::getenv("GT_GE_REVISION_VERIFY") != nullptr;
+    return enabled;
+}
+
+std::uint64_t ge_renderer_revision_verify_mismatches() noexcept {
+    return g_revision_verify_mismatches.exchange(0u, std::memory_order_relaxed);
+}
+
+void verify_cached_draw_state(const std::array<std::uint32_t, 256> &commands, const VertexLayout &layout,
+                              const GeGpuDrawDescriptor &cached) noexcept {
+    GeGpuDrawDescriptor fresh;
+    build_draw_state(commands, layout, fresh);
+    if (!(cached == fresh)) {
+        const auto count = g_revision_verify_mismatches.fetch_add(1u, std::memory_order_relaxed);
+        if (count < 8u) {
+            const auto *x = reinterpret_cast<const unsigned char *>(&cached);
+            const auto *y = reinterpret_cast<const unsigned char *>(&fresh);
+            std::size_t at = 0u;
+            while (at < sizeof fresh && x[at] == y[at]) ++at;
+            std::fprintf(stderr, "[revision-verify] descriptor differs at byte %zu\n", at);
+        }
+    }
+}
