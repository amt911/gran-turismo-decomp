+// GT patch 0030: content hash for the per-draw texture and palette checks. They run on the GE thread for every
+// draw, and a serial mix per 8 bytes made them a fifth of its time in a race; four independent multiply lanes
+// go at memory speed. Only cache keys change: what is drawn is the same.
+std::uint64_t fast_hash_bytes(const std::uint8_t *data, std::size_t size, std::uint64_t seed) noexcept {
+    std::uint64_t lanes[4] = {seed ^ 0x9E3779B97F4A7C15ull, seed ^ 0xC2B2AE3D27D4EB4Full,
+                              seed ^ 0x165667B19E3779F9ull, seed ^ 0x27D4EB2F165667C5ull};
+    std::size_t i = 0u;
+    for (; i + 32u <= size; i += 32u) {
+        for (std::size_t lane = 0u; lane < 4u; ++lane) {
+            std::uint64_t word{};
+            std::memcpy(&word, data + i + lane * 8u, sizeof(word));
+            lanes[lane] = (lanes[lane] ^ word) * 0x9FB21C651E98DF25ull;
+            lanes[lane] ^= lanes[lane] >> 32u;
+        }
+    }
+    std::uint64_t hash = static_cast<std::uint64_t>(size) * 0xD6E8FEB86659FD93ull;
+    for (const std::uint64_t lane : lanes) {
+        hash ^= lane + 0x9E3779B97F4A7C15ull + (hash << 6u) + (hash >> 2u);
+        hash *= 0xD6E8FEB86659FD93ull;
+    }
+    for (; i + 8u <= size; i += 8u) {
+        std::uint64_t word{};
+        std::memcpy(&word, data + i, sizeof(word));
+        hash = (hash ^ word) * 0x9FB21C651E98DF25ull;
+        hash ^= hash >> 29u;
+    }
+    if (i < size) {
+        std::uint64_t tail = 0u;
+        std::memcpy(&tail, data + i, size - i);
+        hash = (hash ^ tail ^ (static_cast<std::uint64_t>(size - i) << 56u)) * 0x9FB21C651E98DF25ull;
+        hash ^= hash >> 29u;
+    }
+    return hash;
+}
+
+// GT patch 0030: within one display list the same palettes and small textures are checked by draw after draw
+// with the same bytes; remember each content hash until the list ends or a block transfer writes memory
+// (ge_renderer_forget_content_hashes). Direct-mapped, per thread (the GE runs on one).
+std::atomic<std::uint64_t> g_content_generation{1u};
+
+struct RememberedHash {
+    std::uint32_t address{};
+    std::uint32_t bytes{};
+    std::uint64_t extra{};
+    std::uint64_t generation{};
+    std::uint64_t value{};
+};
+
+std::uint64_t remembered_content_hash(const std::uint8_t *data, std::uint32_t address, std::size_t bytes,
+                                      std::uint64_t extra, std::uint64_t seed) noexcept {
+    static thread_local std::array<RememberedHash, 2048> remembered{};
+    const std::uint64_t generation = g_content_generation.load(std::memory_order_relaxed);
+    const std::size_t slot = ((address >> 4u) ^ (address >> 15u) ^ static_cast<std::size_t>(bytes) * 2654435761u ^
+                              static_cast<std::size_t>(extra)) & (remembered.size() - 1u);
+    RememberedHash &entry = remembered[slot];
+    if (entry.generation == generation && entry.address == address && entry.bytes == bytes && entry.extra == extra)
+        return entry.value;
+    entry = {address, static_cast<std::uint32_t>(bytes), extra, generation, fast_hash_bytes(data, bytes, seed)};
+    return entry.value;
+}
