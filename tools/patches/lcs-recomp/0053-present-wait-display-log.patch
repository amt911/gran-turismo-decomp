+// GT patch 0053: waits for each present in order and reports it shown; stopped (and joined) before the swapchain it waits
+// on is destroyed, so it never waits on a dead handle.
+void present_waiter_stop(VulkanState &s) {
+    if (!s.waiter.thread.joinable()) return;
+    {
+        std::lock_guard lock(s.waiter.mutex);
+        s.waiter.stop = true;
+    }
+    s.waiter.wake.notify_all();
+    s.waiter.thread.join();
+    s.waiter.ids.clear();
+    s.waiter.stop = false;
+}
+
+void present_waiter_push(VulkanState &s, std::uint64_t id) {
+    if (!s.waiter.thread.joinable()) {
+        s.waiter.thread = std::thread([device = s.device, swapchain = s.swapchain, wait = s.wait_for_present,
+                                       &waiter = s.waiter] {
+            for (;;) {
+                std::uint64_t next = 0u;
+                {
+                    std::unique_lock lock(waiter.mutex);
+                    waiter.wake.wait(lock, [&] { return waiter.stop.load() || !waiter.ids.empty(); });
+                    if (waiter.stop) return;
+                    next = waiter.ids.front();
+                    waiter.ids.pop_front();
+                }
+                VkResult result = VK_TIMEOUT;
+                while (result == VK_TIMEOUT && !waiter.stop) result = wait(device, swapchain, next, 20'000'000ull);
+                if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR)
+                    if (GeGpuDisplayHook hook = g_display_hook.load()) hook(next);
+            }
+        });
+    }
+    {
+        std::lock_guard lock(s.waiter.mutex);
+        s.waiter.ids.push_back(id);
+    }
+    s.waiter.wake.notify_one();
+}
