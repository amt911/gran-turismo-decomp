+// GT patch 0031: a clear-mode sprite is drawn as a clear when that changes no pixel. GT clears its targets with
+// clear-mode rectangles every frame (a third of the fragments in a race); drawn, each runs the whole fragment
+// shader over the rectangle, while vkCmdClearAttachments is a fixed-function fill (a fast clear on most GPUs).
+// Only when the result is the same: one axis-aligned rectangle of untransformed vertices, one colour and one z,
+// all colour channels or none written, no other state that could change a pixel. Coverage follows the
+// rasterizer's rule (pixel centres in [x0, x1), [y0, y1)); the depth is what ge.frag writes for that z.
+bool clear_rectangle(VulkanState &s, const Batch &batch, const Target &target, const VkRect2D &scissor) {
+    const GeGpuDrawDescriptor &draw = batch.draw;
+    if (!draw.clear_mode || batch.hardware_transform || batch.framebuffer_feedback) return false;
+    const VkColorComponentFlags mask = color_write_mask(draw);
+    const bool write_color = mask == (VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT |
+                                      VK_COLOR_COMPONENT_A_BIT);
+    if (!write_color && mask != 0u) return false;  // some channels only: keep the draw
+    const bool write_depth = draw.depth_write_enabled;
+    if (!write_color && !write_depth) return false;
+    if (draw.depth_test_enabled || draw.blend_enabled || draw.alpha_test_enabled || draw.texture_enabled ||
+        draw.fog_enabled)
+        return false;
+    const std::uint32_t count = batch.indexed ? batch.index_count : batch.vertex_count;
+    if (count != 6u) return false;  // one rectangle: two triangles
+    float xs[2]{}, ys[2]{};
+    std::uint32_t nx = 0u, ny = 0u;
+    std::uint32_t rgba = 0u;
+    float z = 0.0f;
+    for (std::uint32_t i = 0u; i < count; ++i) {
+        const std::size_t index = batch.indexed
+            ? static_cast<std::size_t>(batch.first_vertex) + s.indices[batch.first_index + i]
+            : static_cast<std::size_t>(batch.first_vertex) + i;
+        if (index >= s.vertices.size()) return false;
+        const UploadVertex &v = s.vertices[index];
+        if (v.w != 1.0f) return false;
+        if (i == 0u) {
+            rgba = v.rgba;
+            z = v.z;
+        } else if ((write_color && v.rgba != rgba) || (write_depth && v.z != z)) {
+            return false;
+        }
+        const auto note = [](float value, float (&seen)[2], std::uint32_t &n) {
+            for (std::uint32_t k = 0u; k < n; ++k) if (seen[k] == value) return true;
+            if (n == 2u) return false;
+            seen[n++] = value;
+            return true;
+        };
+        if (!std::isfinite(v.x) || !std::isfinite(v.y) || std::fabs(v.x) > 65536.0f || std::fabs(v.y) > 65536.0f)
+            return false;
+        if (!note(v.x, xs, nx) || !note(v.y, ys, ny)) return false;
+    }
+    if (nx != 2u || ny != 2u) return false;
+    // Two triangles cover the rectangle only if each uses three different corners and together they use all four
+    // (they then share the diagonal). Corner = bit (x is xs[1]) | 2 * (y is ys[1]).
+    unsigned used_by[2]{};
+    for (std::uint32_t t = 0u; t < 2u; ++t) {
+        for (std::uint32_t k = 0u; k < 3u; ++k) {
+            const std::uint32_t i = t * 3u + k;
+            const std::size_t index = batch.indexed
+                ? static_cast<std::size_t>(batch.first_vertex) + s.indices[batch.first_index + i]
+                : static_cast<std::size_t>(batch.first_vertex) + i;
+            const UploadVertex &v = s.vertices[index];
+            const unsigned corner = (v.x == xs[1] ? 1u : 0u) | (v.y == ys[1] ? 2u : 0u);
+            if ((used_by[t] >> corner) & 1u) return false;  // a repeated corner: a degenerate triangle
+            used_by[t] |= 1u << corner;
+        }
+    }
+    if ((used_by[0] | used_by[1]) != 0xFu) return false;
+    const float scale_x = static_cast<float>(s.target_width) / static_cast<float>(std::max<std::uint32_t>(1u, target.logical_width));
+    const float scale_y = static_cast<float>(s.target_height) / static_cast<float>(std::max<std::uint32_t>(1u, target.logical_height));
+    // Only edges that land on whole target pixels: the rasterizer snaps vertices to a sub-pixel grid, and a
+    // fractional edge near a pixel centre could then cover a column this computation would not.
+    for (const float edge : {xs[0] * scale_x, xs[1] * scale_x, ys[0] * scale_y, ys[1] * scale_y})
+        if (edge != std::floor(edge)) return false;
+    const auto first_pixel = [](float edge) { return static_cast<std::int64_t>(std::ceil(edge - 0.5f)); };
+    std::int64_t x0 = first_pixel(std::min(xs[0], xs[1]) * scale_x), x1 = first_pixel(std::max(xs[0], xs[1]) * scale_x);
+    std::int64_t y0 = first_pixel(std::min(ys[0], ys[1]) * scale_y), y1 = first_pixel(std::max(ys[0], ys[1]) * scale_y);
+    x0 = std::max<std::int64_t>(x0, scissor.offset.x);
+    y0 = std::max<std::int64_t>(y0, scissor.offset.y);
+    x1 = std::min<std::int64_t>(x1, static_cast<std::int64_t>(scissor.offset.x) + scissor.extent.width);
+    y1 = std::min<std::int64_t>(y1, static_cast<std::int64_t>(scissor.offset.y) + scissor.extent.height);
+    if (x1 <= x0 || y1 <= y0) return true;  // covers no pixel: nothing to draw either
+    VkClearAttachment clears[2]{};
+    std::uint32_t clear_count = 0u;
+    if (write_color) {
+        VkClearAttachment &color = clears[clear_count++];
+        color.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        color.colorAttachment = 0u;
+        for (std::uint32_t c = 0u; c < 4u; ++c)
+            color.clearValue.color.float32[c] = static_cast<float>((rgba >> (c * 8u)) & 0xFFu) / 255.0f;
+    }
+    if (write_depth) {
+        // As the vertex and fragment shaders compute it: clamp(z / 65535), then GT patch 0025's 16-bit truncation.
+        const float depth = std::clamp(z * (1.0f / 65535.0f), 0.0f, 1.0f);
+        VkClearAttachment &d = clears[clear_count++];
+        d.aspectMask = VK_IMAGE_ASPECT_DEPTH_BIT;
+        d.clearValue.depthStencil.depth = std::floor(depth * 65535.0f + 1.0f / 64.0f) / 65535.0f;
+    }
+    VkClearRect rect{};
+    rect.rect.offset = {static_cast<std::int32_t>(x0), static_cast<std::int32_t>(y0)};
+    rect.rect.extent = {static_cast<std::uint32_t>(x1 - x0), static_cast<std::uint32_t>(y1 - y0)};
+    rect.layerCount = 1u;
+    vkCmdClearAttachments(s.command, clear_count, clears, 1u, &rect);
+    ++s.report.clear_rectangles;  // GT patch 0031
+    return true;
+}
