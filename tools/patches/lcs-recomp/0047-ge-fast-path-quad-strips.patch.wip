GT patch 0047 (WIP, not for merge): quad-strip fast path. Verify still reports 0.2 % texture_content_signature mismatches: the guard needs the frame epoch too.

--- a/lcs/host/ge_renderer.cpp
+++ b/lcs/host/ge_renderer.cpp
@@ -4189,6 +4189,109 @@
     return queue;
 }
 
+// GT patch 0047: GT's quad strips on a draw-state revision hit (docs/superpowers/specs/2026-10-16-ge-fast-path-design.md).
+// 94 % of a race's draws are textured strips of at most 8 vertices with no lighting, UV generation, morph, skinning,
+// normals, indices or flat shading; before ~97 % of draws only the texture level 0xC8 or nothing changes. A draw like
+// the previous one of the same revision reuses its descriptor and hardware transform (and with them the texture and
+// target lookups the general path does per draw), decodes its vertices with the same readers and hands them to the
+// same backend call the general path uses, with the same strip-to-list indices.
+struct FastStripCache {
+    std::uint64_t revision{};
+    std::uint64_t write_clock{};  // ge_gpu_backend_write_clock() when filled: a noted guest write ends the reuse
+    std::uint32_t layout_type{};
+    DualPass dual_pass{DualPass::None};
+    bool eligible{};
+    GeGpuDrawDescriptor draw{};
+    GeGpuHardwareTransform hw{};
+    Color material{};
+};
+
+FastStripCache &fast_strip_cache() noexcept {
+    static thread_local FastStripCache cache;
+    return cache;
+}
+
+bool fastpath_verify_enabled() noexcept {
+    static const bool enabled = std::getenv("GT_GE_FASTPATH_VERIFY") != nullptr;
+    return enabled;
+}
+
+bool fastpath_enabled() noexcept {
+    static const bool enabled = std::getenv("GT_GE_NO_FASTPATH") == nullptr;
+    return enabled;
+}
+
+std::atomic<std::uint64_t> g_fastpath_draws{0u};
+std::atomic<std::uint64_t> g_fastpath_verified{0u};
+std::atomic<std::uint64_t> g_fastpath_mismatches{0u};
+
+// The inputs of the backend call for a fast draw: the cached descriptor and transform with this draw's per-draw fields,
+// the vertices decoded from `raw` and the strip's triangle indices (as hw_job_prepare emits them).
+void fast_strip_inputs(const FastStripCache &cache, const std::array<std::uint32_t, 256> &commands,
+                       const VertexLayout &layout, const std::uint8_t *raw, std::uint32_t count,
+                       GeGpuDrawDescriptor &draw, GeGpuHardwareTransform &hw,
+                       std::vector<GeGpuVertex> &vertices, std::vector<std::uint32_t> &indices) {
+    std::memcpy(static_cast<void *>(&draw), &cache.draw, sizeof draw);
+    const std::uint32_t texture_level = data24(commands[0xC8u]);
+    draw.texture_level_mode = texture_level & 3u;
+    draw.texture_level_offset16 = signed_texture_lod_offset16(texture_level);
+    draw.texture_selected_level = selected_texture_level(commands);
+    draw.vertex_count = count;
+    hw = cache.hw;
+    hw.unique_vertices_decoded = count;
+    hw.index_reuses = 0u;
+    hw.primitive = 3u;  // the strip goes as a triangle list, as hw_job_commit sends it
+    vertices.resize(count);
+    for (std::uint32_t i = 0u; i < count; ++i) {
+        const std::uint8_t *vertex_bytes = raw + static_cast<std::size_t>(i) * layout.stride;
+        float u = 0.0f, v = 0.0f;
+        read_texcoord_raw(vertex_bytes + layout.tc_offset, layout.tc_type, u, v);
+        const Color color = layout.color_type < 4u
+            ? cache.material : read_vertex_color_raw(vertex_bytes + layout.color_offset, layout.color_type);
+        const Vec3 position = read_vector3_raw(vertex_bytes + layout.position_offset, layout.position_type);
+        GeGpuVertex &out = vertices[i];
+        out = {};
+        out.x = position.x;
+        out.y = position.y;
+        out.z = position.z;
+        out.w = 1.0f;
+        out.u = u;
+        out.v = v;
+        out.q = 1.0f;
+        out.fog_factor = 1.0f;
+        out.rgba = pack_gpu_color(color);
+    }
+    indices.clear();
+    for (std::uint32_t i = 0u; i + 2u < count; ++i) {
+        if ((i & 1u) == 0u) {
+            indices.push_back(i);
+            indices.push_back(i + 1u);
+        } else {
+            indices.push_back(i + 1u);
+            indices.push_back(i);
+        }
+        indices.push_back(i + 2u);
+    }
+}
+
+bool same_upload_vertex(const GeGpuVertex &a, const GeGpuVertex &b) noexcept {  // the fields UploadVertex keeps
+    return std::memcmp(&a.x, &b.x, sizeof(float)) == 0 && std::memcmp(&a.y, &b.y, sizeof(float)) == 0 &&
+           std::memcmp(&a.z, &b.z, sizeof(float)) == 0 && std::memcmp(&a.w, &b.w, sizeof(float)) == 0 &&
+           a.rgba == b.rgba && std::memcmp(&a.u, &b.u, sizeof(float)) == 0 &&
+           std::memcmp(&a.v, &b.v, sizeof(float)) == 0 && std::memcmp(&a.q, &b.q, sizeof(float)) == 0 &&
+           std::memcmp(&a.fog_factor, &b.fog_factor, sizeof(float)) == 0;
+}
+
+}  // namespace
+
+std::uint64_t ge_renderer_fastpath_draws() noexcept { return g_fastpath_draws.exchange(0u, std::memory_order_relaxed); }
+std::uint64_t ge_renderer_fastpath_verified() noexcept { return g_fastpath_verified.exchange(0u, std::memory_order_relaxed); }
+std::uint64_t ge_renderer_fastpath_mismatches() noexcept {
+    return g_fastpath_mismatches.exchange(0u, std::memory_order_relaxed);
+}
+
+namespace {
+
