+// GT patch 0047: the guest-write clock, for the renderer's quad-strip fast path: a draw reuses the previous draw's
+// texture state only when no write was noted since (the CPU rewrites some textures while a list runs).
+std::uint64_t ge_gpu_backend_write_clock() noexcept {
+    VulkanState &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    return s.write_clock;
+}
+
 void ge_gpu_backend_note_guest_write(std::uint32_t address, std::uint32_t bytes) noexcept {
     VulkanState &s = state();
     std::lock_guard<std::recursive_mutex> guard(s.mutex);
