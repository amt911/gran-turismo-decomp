+// GT patch 0051: whether two descriptors are equal but for the fields a batch merge lets differ (the vertex count and
+// the texture level selection, which the vertices carry), without copying 352 bytes first. Padding is zero in every
+// descriptor (patch 0046), so the byte compare is the one the copy-and-memcmp made.
+bool same_draw_but_per_draw_fields(const GeGpuDrawDescriptor &a, const GeGpuDrawDescriptor &b) noexcept {
+    struct Skip {
+        std::size_t offset;
+        std::size_t size;
+    };
+    static constexpr Skip kSkip[] = {
+        {offsetof(GeGpuDrawDescriptor, vertex_count), sizeof(GeGpuDrawDescriptor::vertex_count)},
+        {offsetof(GeGpuDrawDescriptor, texture_level_mode), sizeof(GeGpuDrawDescriptor::texture_level_mode)},
+        {offsetof(GeGpuDrawDescriptor, texture_level_offset16), sizeof(GeGpuDrawDescriptor::texture_level_offset16)},
+        {offsetof(GeGpuDrawDescriptor, texture_selected_level), sizeof(GeGpuDrawDescriptor::texture_selected_level)},
+    };
+    static_assert(kSkip[0].offset < kSkip[1].offset && kSkip[1].offset < kSkip[2].offset &&
+                  kSkip[2].offset < kSkip[3].offset);
+    const auto *pa = reinterpret_cast<const unsigned char *>(&a);
+    const auto *pb = reinterpret_cast<const unsigned char *>(&b);
+    std::size_t at = 0u;
+    for (const Skip &skip : kSkip) {
+        if (std::memcmp(pa + at, pb + at, skip.offset - at) != 0) return false;
+        at = skip.offset + skip.size;
+    }
+    return std::memcmp(pa + at, pb + at, sizeof(GeGpuDrawDescriptor) - at) == 0;
 }
 
