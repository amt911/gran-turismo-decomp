+// GT patch 0071: the mod draw layer's worker: the same shape as the UI picture's (one slot for the newest request, one finished picture).
+namespace {
+
+struct DrawWorker {
+    std::mutex mutex;
+    std::condition_variable wake;
+    bool synchronous = false;
+    bool started = false;
+    bool pending = false;
+    std::vector<HostDrawCmd> list;        // the list submitted
+    std::uint64_t list_generation = 0;    // bumped by each submit
+    std::vector<HostDrawCmd> wanted;
+    SettingsOverlaySize wanted_size{};
+    bool have_last = false;               // the (generation, size) last taken, to skip an identical request
+    std::uint64_t last_generation = 0;
+    SettingsOverlaySize last_size{};
+    std::vector<std::uint8_t> picture;
+    SettingsOverlayPicture info{};
+    std::uint64_t versions = 0;
+};
+
+DrawWorker &draw_worker() {
+    static DrawWorker *worker = new DrawWorker();  // never destroyed: the detached thread may still hold it at exit
+    return *worker;
+}
+
+void draw_rasterize(DrawWorker &w, const std::vector<HostDrawCmd> &list, SettingsOverlaySize size, std::unique_lock<std::mutex> &lock) {
+    lock.unlock();
+    std::vector<std::uint8_t> pixels(static_cast<std::size_t>(size.width) * size.height * 4u);
+    host_style_rasterize_draw(list.data(), list.size(), pixels.data(), size.width, size.height);
+    lock.lock();
+    w.picture.swap(pixels);
+    w.info = SettingsOverlayPicture{size.width, size.height, ++w.versions};
+}
+
+void draw_thread() {
+    DrawWorker &w = draw_worker();
+    std::unique_lock<std::mutex> lock(w.mutex);
+    for (;;) {
+        w.wake.wait(lock, [&w] { return w.pending; });
+        const std::vector<HostDrawCmd> list = w.wanted;
+        const SettingsOverlaySize size = w.wanted_size;
+        w.pending = false;
+        draw_rasterize(w, list, size, lock);
+    }
+}
+
+}  // namespace
+
+void host_draw_submit(const HostDrawCmd *commands, std::size_t count) noexcept {
+    DrawWorker &w = draw_worker();
+    std::lock_guard<std::mutex> lock(w.mutex);
+    if (commands == nullptr) count = 0u;
+    w.list.assign(commands, commands + count);
+    ++w.list_generation;
+    if (count == 0u) {  // no layer: forget the picture so a later list is rasterized afresh
+        w.info = SettingsOverlayPicture{};
+        w.picture.clear();
+        w.pending = false;
+        w.have_last = false;
+    }
+}
+
+bool host_draw_active() noexcept {
+    DrawWorker &w = draw_worker();
+    std::lock_guard<std::mutex> lock(w.mutex);
+    return !w.list.empty();
+}
+
+SettingsOverlayPicture host_draw_request(SettingsOverlaySize size) noexcept {
+    DrawWorker &w = draw_worker();
+    std::unique_lock<std::mutex> lock(w.mutex);
+    if (w.list.empty() || size.width == 0u || size.height == 0u) return SettingsOverlayPicture{};
+    const bool repeat = w.have_last && w.last_generation == w.list_generation && w.last_size.width == size.width && w.last_size.height == size.height;
+    if (!repeat) {
+        w.have_last = true;
+        w.last_generation = w.list_generation;
+        w.last_size = size;
+        if (w.synchronous) {
+            const std::vector<HostDrawCmd> list = w.list;
+            draw_rasterize(w, list, size, lock);
+        } else {
+            w.wanted = w.list;
+            w.wanted_size = size;
+            w.pending = true;
+            if (!w.started) {
+                w.started = true;
+                try {
+                    std::thread(draw_thread).detach();
+                } catch (...) {  // no thread: rasterize here
+                    w.synchronous = true;
+                    w.pending = false;
+                    const std::vector<HostDrawCmd> list = w.list;
+                    draw_rasterize(w, list, size, lock);
+                }
+            }
+            w.wake.notify_one();
+        }
+    }
+    return w.info;
+}
+
+bool host_draw_copy(std::uint64_t version, std::uint8_t *rgba, std::size_t capacity) noexcept {
+    DrawWorker &w = draw_worker();
+    std::lock_guard<std::mutex> lock(w.mutex);
+    if (version == 0u || w.info.version != version || rgba == nullptr || capacity < w.picture.size()) return false;
+    std::memcpy(rgba, w.picture.data(), w.picture.size());
+    return true;
+}
+
+void host_draw_rasterize(const HostDrawCmd *commands, std::size_t count, std::uint8_t *rgba, std::uint32_t width,
+                         std::uint32_t height) noexcept {
+    host_style_rasterize_draw(commands, count, rgba, width, height);
+}
+
+void host_draw_set_synchronous(bool synchronous) noexcept {
+    DrawWorker &w = draw_worker();
+    std::lock_guard<std::mutex> lock(w.mutex);
+    w.synchronous = synchronous;
+}
+
