                            std::uint32_t height) noexcept {
     if (rgba == nullptr || width == 0u || height == 0u) return;
diff --git a/lcs/host/lcs_host_style.cpp b/lcs/host/lcs_host_style.cpp
index 6ba5498..edb5b77 100644
--- a/lcs/host/lcs_host_style.cpp
+++ b/lcs/host/lcs_host_style.cpp
@@ -565,4 +565,45 @@ bool host_style_rasterize(const HostSettingsView &view, std::uint8_t *rgba, std:
     return true;
 }
 
+void host_style_rasterize_draw(const HostDrawCmd *commands, std::size_t count, std::uint8_t *rgba, std::uint32_t width,
+                               std::uint32_t height) noexcept {
+    if (rgba == nullptr || width == 0u || height == 0u) return;
+    std::memset(rgba, 0, static_cast<std::size_t>(width) * height * 4u);
+    if (commands == nullptr) return;
+    Style &s = style();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    const bool fonts = ensure_fonts(s);
+    const Canvas c{rgba, static_cast<int>(width), static_cast<int>(height), s, static_cast<float>(width) / static_cast<float>(kDrawLogicalWidth)};
+    for (std::size_t i = 0; i < count; ++i) {
+        const HostDrawCmd &cmd = commands[i];
+        const Rgb color{cmd.rgba[0], cmd.rgba[1], cmd.rgba[2]};
+        const float alpha = static_cast<float>(cmd.rgba[3]) / 255.0f;
+        switch (cmd.kind) {
+        case HostDrawKind::Rect: {  // anti-aliased edges: each pixel's coverage = the overlap of its box with the rectangle
+            const float sx = cmd.a * c.S, sy = cmd.b * c.S, ex = (cmd.a + cmd.c) * c.S, ey = (cmd.b + cmd.d) * c.S;
+            const float x0 = std::min(sx, ex), x1 = std::max(sx, ex), y0 = std::min(sy, ey), y1 = std::max(sy, ey);
+            const int ix0 = std::max(0, static_cast<int>(std::floor(x0))), ix1 = std::min(c.w, static_cast<int>(std::ceil(x1)));
+            const int iy0 = std::max(0, static_cast<int>(std::floor(y0))), iy1 = std::min(c.h, static_cast<int>(std::ceil(y1)));
+            for (int y = iy0; y < iy1; ++y) {
+                const float cy = std::min(y1, static_cast<float>(y + 1)) - std::max(y0, static_cast<float>(y));
+                for (int x = ix0; x < ix1; ++x) {
+                    const float cx = std::min(x1, static_cast<float>(x + 1)) - std::max(x0, static_cast<float>(x));
+                    c.blend(x, y, color, cx * cy * alpha);
+                }
+            }
+            break;
+        }
+        case HostDrawKind::Line: c.line(cmd.a, cmd.b, cmd.c, cmd.d, cmd.e, color, alpha); break;
+        case HostDrawKind::Text:
+            if (fonts && cmd.c > 0.0f) {
+                char text[kDrawTextCapacity];
+                std::memcpy(text, cmd.text, sizeof text);
+                text[sizeof text - 1] = '\0';
+                c.text(kFontMedium, cmd.c, cmd.a, cmd.b + cmd.c * 0.8f, text, color, alpha);  // `b` is the top of the line, the pen is at its baseline
+            }
+            break;
+        }
+    }
+}
+
 }  // namespace lcs
