+// Copies the picture into the staging area when it must be uploaded; true when the layer is drawn this frame.
+bool prepare_mod_draw(VulkanState &s, const ModDrawPlan &plan, VkDeviceSize offset, bool &upload, std::string &error) {
+    upload = false;
+    if (plan.version == 0u) return false;
+    if (plan.upload) {
+        auto *mapped = static_cast<std::uint8_t *>(s.present_staging_mapped);
+        if (mapped != nullptr && ensure_overlay_image(s, s.mod_draw, plan.width, plan.height, error) &&
+            host_draw_copy(plan.version, mapped + offset, static_cast<std::size_t>(plan.width) * plan.height * 4u)) {
+            upload = true;
+        } else {
+            s.mod_draw_version = 0u;  // a newer picture replaced it (or no image): ask again next frame
+        }
+    }
+    return s.mod_draw.image != VK_NULL_HANDLE && (upload || s.mod_draw_version != 0u);
+}
