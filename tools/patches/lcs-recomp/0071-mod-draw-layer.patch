+ModDrawPlan plan_mod_draw(VulkanState &s, std::uint32_t source_width, std::uint32_t source_height) {
+    ModDrawPlan plan;
+    if (!host_draw_active()) return plan;
+    const DisplayConfiguration &display = lcs_render_configuration().display;
+    const PresentationRectangle fitted = calculate_presentation_rectangle(s.swap_width, s.swap_height, source_width, source_height,
+                                                                          display.aspect_mode, display.integer_scale);
+    const SettingsOverlayPicture picture = host_draw_request(host_draw_size(static_cast<float>(fitted.width)));
+    if (picture.version == 0u) return plan;
+    plan.version = picture.version;
+    plan.width = picture.width;
+    plan.height = picture.height;
+    plan.upload = picture.version != s.mod_draw_version || s.mod_draw.image == VK_NULL_HANDLE || s.mod_draw.width != picture.width ||
+                  s.mod_draw.height != picture.height;
+    return plan;
