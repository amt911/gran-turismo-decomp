+// GT patch 0071: the mods' draw layer over the game rectangle (rasterized on its worker at that rectangle's size).
+void paint_mod_draw(SDL_Renderer *renderer, const SDL_Rect &game) noexcept {
+    if (renderer == nullptr || game.w <= 0 || game.h <= 0 || !host_draw_active()) return;
+    static SDL_Renderer *owner = nullptr;
+    static SDL_Texture *texture = nullptr;
+    static std::uint32_t texture_w = 0u, texture_h = 0u;
+    static std::uint64_t shown = 0u;
+    static std::vector<std::uint8_t> pixels;
+    const SettingsOverlayPicture picture = host_draw_request(host_draw_size(static_cast<float>(game.w)));
+    if (picture.version == 0u) return;
+    if (owner != renderer || texture == nullptr || texture_w != picture.width || texture_h != picture.height) {
+        if (texture != nullptr && owner == renderer) SDL_DestroyTexture(texture);
+        texture = SDL_CreateTexture(renderer, SDL_PIXELFORMAT_ABGR8888, SDL_TEXTUREACCESS_STREAMING,
+                                    static_cast<int>(picture.width), static_cast<int>(picture.height));
+        owner = renderer;
+        shown = 0u;
+        texture_w = picture.width;
+        texture_h = picture.height;
+        if (texture == nullptr) return;
+        SDL_SetTextureBlendMode(texture, SDL_BLENDMODE_BLEND);
+        SDL_SetTextureScaleMode(texture, SDL_ScaleModeLinear);
+    }
+    if (picture.version != shown) {
+        pixels.resize(static_cast<std::size_t>(picture.width) * picture.height * 4u);
+        if (host_draw_copy(picture.version, pixels.data(), pixels.size())) {
+            SDL_UpdateTexture(texture, nullptr, pixels.data(), static_cast<int>(picture.width * 4u));
+            shown = picture.version;
+        }
+    }
+    if (shown != 0u) SDL_RenderCopy(renderer, texture, nullptr, &game);
+}
+
