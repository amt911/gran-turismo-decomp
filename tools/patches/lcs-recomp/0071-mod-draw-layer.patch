+// GT patch 0071: the mod draw layer (include/gt_mod/gt_mod_api.h, v8). A mod's draw calls become a command list in a 480 x 272
+// logical space; the list is rasterized on its own worker (like the UI picture above) at the size of the shown game rectangle and
+// composited over the game, under the F9 / F10 panels. Straight-alpha pixels, anti-aliased shapes, the UI font for text.
+inline constexpr std::uint32_t kDrawLogicalWidth = 480u;
+inline constexpr std::uint32_t kDrawLogicalHeight = 272u;
+inline constexpr std::size_t kDrawTextCapacity = 96u;
+enum class HostDrawKind : std::uint8_t { Text, Rect, Line };
+struct HostDrawCmd {
+    HostDrawKind kind{HostDrawKind::Rect};
+    // Text: a = x, b = y (top of the line), c = size. Rect: a, b = x, y; c, d = w, h. Line: a, b = x0, y0; c, d = x1, y1; e = width.
+    float a{0}, b{0}, c{0}, d{0}, e{0};
+    std::uint8_t rgba[4]{255, 255, 255, 255};
+    char text[kDrawTextCapacity]{};
+};
+// Replaces the list drawn (an empty one removes the layer). Any thread.
+void host_draw_submit(const HostDrawCmd *commands, std::size_t count) noexcept;
+// True while a non-empty list is submitted.
+[[nodiscard]] bool host_draw_active() noexcept;
+// The newest finished picture of the list for `size` (the shown game rectangle's pixels); version 0: none yet / no layer. Same contract as
+// settings_overlay_request / settings_overlay_copy.
+SettingsOverlayPicture host_draw_request(SettingsOverlaySize size) noexcept;
+bool host_draw_copy(std::uint64_t version, std::uint8_t *rgba, std::size_t capacity) noexcept;
+// The size of the draw picture for a game rectangle of `width` pixels: 480 x 272 scaled uniformly.
+[[nodiscard]] inline SettingsOverlaySize host_draw_size(float width) noexcept {
+    if (width < 1.0f) width = 1.0f;
+    const auto w = static_cast<std::uint32_t>(width + 0.5f);
+    return {w, static_cast<std::uint32_t>(static_cast<float>(w) * kDrawLogicalHeight / kDrawLogicalWidth + 0.5f)};
+}
+// Rasterizes `commands` into `rgba` (width x height, straight alpha, cleared first) on the calling thread. Text is skipped when the UI
+// font is missing. Tests, frame dumps.
