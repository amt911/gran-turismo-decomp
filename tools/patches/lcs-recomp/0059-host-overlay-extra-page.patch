+int extra_page() {
+    using namespace lcs;
+    // No provider: F9 does nothing and the main page is exactly as before.
+    if (host_settings_handle(HostSettingsKey::TogglePage) || host_settings_open()) return fail("F9 without a provider");
+    if (!host_settings_handle(HostSettingsKey::Toggle)) return fail("open main");
+    HostSettingsView main_view = host_settings_view();
+    if (std::string(main_view.title) != "HOST SETTINGS" || std::string(main_view.footer) != "F10 CLOSE")
+        return fail("main page title/footer");
+    if (!host_settings_handle(HostSettingsKey::Activate) || !host_settings_open()) return fail("Enter on the main page");
+    host_settings_handle(HostSettingsKey::Close);
+
+    static const HostExtraPage page{"MODS", fake_count, fake_row, fake_toggle};
+    host_settings_set_extra_page(&page);
+    if (!host_settings_handle(HostSettingsKey::TogglePage) || !host_settings_open()) return fail("F9 did not open");
+    HostSettingsView view = host_settings_view();
+    if (std::string(view.title) != "MODS" || std::string(view.footer) != "F9 CLOSE") return fail("extra title/footer");
+    if (view.selected != 0 || std::string(view.rows[0]) != "MOD0 OFF" || std::string(view.rows[4]) != "MOD4 OFF")
+        return fail("first window");
+    for (int i = 0; i < 6; ++i) host_settings_handle(HostSettingsKey::Down);
+    view = host_settings_view();
+    if (view.selected != 4 || std::string(view.rows[0]) != "MOD2 OFF" || std::string(view.rows[4]) != "MOD6 OFF")
+        return fail("window after Down x6 (selection 6, items 2..6)");
+    if (!host_settings_handle(HostSettingsKey::Right) || g_fake_toggled != 6) return fail("Right toggled item 6");
+    if (std::string(host_settings_view().rows[4]) != "MOD6 ON") return fail("row reflects the toggle");
+    host_settings_handle(HostSettingsKey::Activate);
+    if (g_fake_toggled != 6) return fail("Enter toggles");
+    host_settings_handle(HostSettingsKey::Left);
+    if (std::string(host_settings_view().rows[4]) != "MOD6 ON") return fail("Left toggles (twice more = ON)");
+    host_settings_handle(HostSettingsKey::Down);  // 7
+    host_settings_handle(HostSettingsKey::Down);  // wraps to 0
+    view = host_settings_view();
+    if (view.selected != 0 || std::string(view.rows[0]) != "MOD0 OFF") return fail("wrap to the first item");
+    for (int i = 0; i < 3; ++i) host_settings_handle(HostSettingsKey::Up);  // 0 -> 7 -> 6 -> 5
+    view = host_settings_view();
+    if (view.selected != 2 || std::string(view.rows[0]) != "MOD3 OFF") return fail("window at the end (3..7)");
+    // F9 again closes; F10 while on the extra page closes; F10 afterwards opens the main page again.
+    if (!host_settings_handle(HostSettingsKey::TogglePage) || host_settings_open()) return fail("F9 closes");
+    host_settings_handle(HostSettingsKey::TogglePage);
+    host_settings_handle(HostSettingsKey::Toggle);
+    if (host_settings_open()) return fail("F10 closes the extra page");
+    host_settings_handle(HostSettingsKey::Toggle);
+    if (std::string(host_settings_view().title) != "HOST SETTINGS") return fail("F10 opens the main page");
+    host_settings_handle(HostSettingsKey::Close);
+    // The overlay paints the extra page's title.
+    host_settings_handle(HostSettingsKey::TogglePage);
+    std::vector<std::uint8_t> rgba(static_cast<std::size_t>(kSettingsOverlayWidth) * kSettingsOverlayHeight * 4u);
+    rasterize_settings_overlay(host_settings_view(), rgba.data(), kSettingsOverlayWidth, kSettingsOverlayHeight);
+    std::size_t lit = 0u;
+    for (std::size_t index = 0u; index + 3u < rgba.size(); index += 4u)
+        if (rgba[index + 3u] == 255u && rgba[index] > 80u) ++lit;
+    if (lit < 40u) return fail("extra page was not painted");
+    host_settings_handle(HostSettingsKey::Close);
+    host_settings_set_extra_page(nullptr);
+    if (host_settings_handle(HostSettingsKey::TogglePage)) return fail("F9 after unregistering");
+    std::cout << "extra_page=1 window=2..6 toggled=6 wrap=1\n";
+    return 0;
+}
