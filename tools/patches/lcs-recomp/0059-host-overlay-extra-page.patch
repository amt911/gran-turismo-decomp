+    const Win32HostKeyDecision up = classify_win32_host_key(kWin32KeyUp, kWin32VkF9, false);
+    const Win32HostKeyDecision repeat = classify_win32_host_key(kWin32KeyDown, kWin32VkF9, true);
+    if (!down.consume || !down.toggle_page || down.toggle_settings) return fail("F9 press");
+    if (!sys_down.consume || !sys_down.toggle_page) return fail("system F9 press");
+    if (!up.consume || up.toggle_page) return fail("F9 release");
+    if (!repeat.consume || repeat.toggle_page) return fail("F9 repeat");
+    std::cout << "f9=consume+page\n";
+    return 0;
+}
