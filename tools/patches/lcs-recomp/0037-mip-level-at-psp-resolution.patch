+// GT patch 0037: the PSP picks an automatic mip level from the texels per pixel of its 480x272 screen
+// (log2 of the larger of ds/dx*width, dt/dy*height, plus the level offset). Vulkan measures the same slope in
+// the internal-resolution pixels, xN smaller, so at x4 it sampled two levels finer than the PSP: distant
+// signboards and fences shimmered and aliased. Adding log2(N) picks the PSP's level at every scale.
+float internal_scale_lod_bias(const VulkanState &s, const GeGpuDrawDescriptor &draw) noexcept {
+    if (draw.texture_level_mode != 0u || !draw.texture_mipmap_enabled || draw.texture_max_level == 0u) return 0.0f;
+    return std::log2(std::max(1.0f, s.pixel_scale_x));
+}
