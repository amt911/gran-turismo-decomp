+// GT patch 0072: the scene grade (include/gt_mod/gt_mod_api.h, v8): c' = clamp(mix(luma(c * tint), c * tint, saturation) * brightness), per
+// channel in 0..1, luma = Rec.709. Neutral (every field 1) is the identity and is never applied (byte-identical frames). The Vulkan present
+// shader and the CPU function below compute the same formula; the SDL path can only scale by tint * brightness (its texture colour mod).
+struct HostSceneGrade {
+    float r{1.0f}, g{1.0f}, b{1.0f}, brightness{1.0f}, saturation{1.0f};
+};
+[[nodiscard]] inline bool host_scene_grade_neutral(const HostSceneGrade &g) noexcept {
+    return g.r == 1.0f && g.g == 1.0f && g.b == 1.0f && g.brightness == 1.0f && g.saturation == 1.0f;
+}
+void host_scene_grade_set(const HostSceneGrade &grade) noexcept;
+[[nodiscard]] HostSceneGrade host_scene_grade() noexcept;
+// Grades `pixels` RGB8 triples in place (the frame dumps, the tests). A neutral grade leaves them untouched.
+void host_scene_grade_apply_rgb(const HostSceneGrade &grade, std::uint8_t *rgb, std::size_t pixels) noexcept;
+
 inline constexpr std::uint32_t kFpsOverlayWidth = 192u;
 inline constexpr std::uint32_t kFpsOverlayHeight = 48u;
 
