@@ -671,6 +671,36 @@ void settings_overlay_set_synchronous(bool synchronous) noexcept {
     w.synchronous = synchronous;
 }
 
+// GT patch 0072: the scene grade.
+namespace {
+std::mutex g_grade_mutex;
+HostSceneGrade g_grade;
+}  // namespace
+
+void host_scene_grade_set(const HostSceneGrade &grade) noexcept {
+    std::lock_guard<std::mutex> lock(g_grade_mutex);
+    g_grade = grade;
+}
+
+HostSceneGrade host_scene_grade() noexcept {
+    std::lock_guard<std::mutex> lock(g_grade_mutex);
+    return g_grade;
+}
+
+void host_scene_grade_apply_rgb(const HostSceneGrade &grade, std::uint8_t *rgb, std::size_t pixels) noexcept {
+    if (rgb == nullptr || host_scene_grade_neutral(grade)) return;
+    const float tint[3] = {grade.r, grade.g, grade.b};
+    for (std::size_t i = 0; i < pixels; ++i) {
+        float c[3];
+        for (int k = 0; k < 3; ++k) c[k] = static_cast<float>(rgb[i * 3u + k]) / 255.0f * tint[k];
+        const float luma = 0.2126f * c[0] + 0.7152f * c[1] + 0.0722f * c[2];
+        for (int k = 0; k < 3; ++k) {
+            const float v = (grade.saturation == 1.0f ? c[k] : luma + (c[k] - luma) * grade.saturation) * grade.brightness;
+            rgb[i * 3u + k] = static_cast<std::uint8_t>(std::clamp(v, 0.0f, 1.0f) * 255.0f + 0.5f);
+        }
+    }
+}
