+// GT patch 0058: a texture's slot is its key without its palette and content: the same texels at the same place.
+// New York's screens cycle their CLUTs, so ~9 textures a frame got a new key, and each made a new image, memory and
+// descriptor set, filled the cache and then made it evict on every new texture (5 ms a frame on the GE thread).
+std::uint64_t texture_slot_key(const GeGpuDrawDescriptor &draw) noexcept {
+    GeGpuDrawDescriptor slot = draw;
+    slot.texture_cache_key_hint = 0u;
+    slot.clut_checksum = 0u;
+    return texture_key(slot);
+}
+
+// GT patch 0058: the new key `to` takes over the image of the slot's previous texture when no draw of this frame
+// sampled that one and it has no upload pending; the draw then decodes into it and uploads over it (prepare_texture).
+void take_over_slot_image(VulkanState &s, const GeGpuDrawDescriptor &draw, std::uint64_t to) {
+    std::uint64_t &latest = s.slot_keys[texture_slot_key(draw)];
+    const std::uint64_t from = std::exchange(latest, to);
+    if (from == 0u || from == to) return;
+    const auto found = s.textures.find(from);
+    if (found == s.textures.end() || found->second.dirty || found->second.last_used_epoch >= s.frame_epoch) return;
+    auto node = s.textures.extract(found);
+    node.key() = to;
+    node.mapped().dirty = true;  // no draw samples it until prepare_texture brings the new texels
+    s.textures.insert(std::move(node));
+    ++s.report.texture_images_reused;
+}
+
