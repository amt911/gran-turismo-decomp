--- a/src/program_analysis.cpp
+++ b/src/program_analysis.cpp
@@ -310,6 +310,31 @@
         if (site.type != 2u || !memory.contains(site.patch_address, 4u)) continue;
         add_seed(seeds, ranges, memory.load32(site.patch_address), "relocated_r_mips32_code_pointer");
     }
+    // HI16/LO16 pairs (lui + addiu) also materialise code pointers: thread entries, callbacks,
+    // alarm handlers passed straight to the kernel. PSP PRX order: one HI16 applies to every
+    // following LO16 until the next HI16; memory is already relocated, so the pair yields the
+    // runtime address. The executable range is the whole RWE segment (it also holds .rodata), so
+    // only addresses that look like a function start are seeded: the instruction pair before them
+    // ends in an unconditional jump (j / jr + delay slot) and the target itself decodes.
+    bool have_hi = false;
+    std::uint32_t current_hi = 0u;
+    for (const auto &site : elf.relocation_sites(load_base)) {
+        if (!memory.contains(site.patch_address, 4u)) continue;
+        if (site.type == 5u) {
+            current_hi = (memory.load32(site.patch_address) & 0xFFFFu) << 16u;
+            have_hi = true;
+            continue;
+        }
+        if (site.type != 6u || !have_hi) continue;
+        const auto lo = static_cast<std::int16_t>(memory.load32(site.patch_address) & 0xFFFFu);
+        const std::uint32_t value = current_hi + static_cast<std::uint32_t>(static_cast<std::int32_t>(lo));
+        if (!is_executable_address(ranges, value) || !is_executable_address(ranges, value - 8u)) continue;
+        const auto before = decode_allegrex(memory.load32(value - 8u));
+        const auto here = decode_allegrex(memory.load32(value));
+        if (before.kind != OpcodeKind::Jr && before.kind != OpcodeKind::J) continue;
+        if (here.kind == OpcodeKind::Unsupported) continue;
+        add_seed(seeds, ranges, value, "relocated_hi16_lo16_code_pointer");
+    }
     return seeds;
 }
 
