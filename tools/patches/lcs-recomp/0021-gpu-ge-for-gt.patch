+// GT patch 0021: the GE blend state mapped to Vulkan in general, the way the software rasterizer
+// (ge_renderer.cpp blend_pixel, the verified reference) blends: all four channels with the same factors.
+// Factors (GE): src 0 Cd, 1 1-Cd; dst 0 Cs, 1 1-Cs; both 2 As, 3 1-As, 4 Ad, 5 1-Ad, 6 min(1, 2As),
+// 7 min(1, 2(1-As)), 8 min(1, 2Ad), 9 min(1, 2(1-Ad)), 10 fixed colour (alpha 1). Equations: 0 add, 1 sub,
+// 2 reverse sub, 3 min, 4 max, 5 abs (no Vulkan op: drawn as add).
+// Factors 6/7 have no Vulkan equivalent: when both factors only depend on the source alpha or are fixed
+// (2, 3, 6, 7, 10) the shader computes them — the colour premultiplied by the source factor (blend ONE)
+// and the destination factor in the second output (dual-source blend, SRC1). 8/9 are drawn as 4/5.
+// A fixed colour is ZERO or ONE when black or white, else the blend constant; when both sides need a
+// different constant the destination falls back to ONE_MINUS_CONSTANT (exact only for complements).
+struct GeneralBlend {
+    bool enable{};
+    VkBlendFactor src{VK_BLEND_FACTOR_ONE};
+    VkBlendFactor dst{VK_BLEND_FACTOR_ZERO};
+    VkBlendOp op{VK_BLEND_OP_ADD};
+    std::uint32_t constant{};  // 0x00BBGGRR
+    bool shader_factors{};     // premultiplied source + SRC1 destination factor
+};
+
+bool source_alpha_only(std::uint32_t code) noexcept {
+    code &= 0xFu;
+    return code == 2u || code == 3u || code == 6u || code == 7u || code == 10u;
+}
+
+std::atomic<bool> g_dual_source_blend{false};  // set when the device enables dualSrcBlend
+bool dual_source_supported() { return g_dual_source_blend.load(std::memory_order_relaxed); }
+
+GeneralBlend general_blend(const GeGpuDrawDescriptor &draw) noexcept {
+    GeneralBlend blend;
+    if (!draw.blend_enabled || draw.clear_mode) return blend;
+    blend.enable = true;
+    const std::uint32_t eq = draw.blend_equation & 7u;
+    blend.op = eq == 1u ? VK_BLEND_OP_SUBTRACT : eq == 2u ? VK_BLEND_OP_REVERSE_SUBTRACT
+             : eq == 3u ? VK_BLEND_OP_MIN : eq == 4u ? VK_BLEND_OP_MAX : VK_BLEND_OP_ADD;
+    const std::uint32_t source = draw.blend_source_factor & 0xFu, dest = draw.blend_dest_factor & 0xFu;
+    const bool doubled = source == 6u || source == 7u || dest == 6u || dest == 7u;
+    if (doubled && source_alpha_only(source) && source_alpha_only(dest) && eq <= 2u && dual_source_supported()) {
+        blend.shader_factors = true;
+        blend.src = VK_BLEND_FACTOR_ONE;
+        blend.dst = VK_BLEND_FACTOR_SRC1_COLOR;
+        return blend;
+    }
+    bool constant_used = false;
+    const auto factor = [&](std::uint32_t code, bool is_source, std::uint32_t fix) {
+        switch (code & 0xFu) {
+        case 0u: return is_source ? VK_BLEND_FACTOR_DST_COLOR : VK_BLEND_FACTOR_SRC_COLOR;
+        case 1u: return is_source ? VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR : VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR;
+        case 2u: case 6u: return VK_BLEND_FACTOR_SRC_ALPHA;
+        case 3u: case 7u: return VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+        case 4u: case 8u: return VK_BLEND_FACTOR_DST_ALPHA;
+        case 5u: case 9u: return VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+        default: break;
+        }
+        fix &= 0x00FFFFFFu;
+        if (fix == 0u) return VK_BLEND_FACTOR_ZERO;
+        if (fix == 0x00FFFFFFu) return VK_BLEND_FACTOR_ONE;
+        if (!constant_used) {
+            constant_used = true;
+            blend.constant = fix;
+            return VK_BLEND_FACTOR_CONSTANT_COLOR;
+        }
+        return VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR;
+    };
+    blend.src = factor(source, true, draw.blend_fix_source);
+    blend.dst = factor(dest, false, draw.blend_fix_dest);
+    return blend;
+}
+
+// The alpha channel blends with the colour factors' alpha counterparts (as the software path does).
+VkBlendFactor alpha_counterpart(VkBlendFactor factor) noexcept {
+    switch (factor) {
+    case VK_BLEND_FACTOR_SRC_COLOR: return VK_BLEND_FACTOR_SRC_ALPHA;
+    case VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR: return VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+    case VK_BLEND_FACTOR_DST_COLOR: return VK_BLEND_FACTOR_DST_ALPHA;
+    case VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR: return VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+    case VK_BLEND_FACTOR_CONSTANT_COLOR: return VK_BLEND_FACTOR_CONSTANT_ALPHA;
+    case VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_COLOR: return VK_BLEND_FACTOR_ONE_MINUS_CONSTANT_ALPHA;
+    case VK_BLEND_FACTOR_SRC1_COLOR: return VK_BLEND_FACTOR_SRC1_ALPHA;
+    default: return factor;
+    }
+}
+
+std::uint64_t general_blend_key(const GeneralBlend &blend) noexcept {
+    if (!blend.enable) return 0u;
+    return 1u | (static_cast<std::uint64_t>(blend.src) << 1u) | (static_cast<std::uint64_t>(blend.dst) << 6u) |
+           (static_cast<std::uint64_t>(blend.op) << 11u);
+}
+
+// The shader's view of the blend (DrawUniforms pixel1.y/z/w): bit 0 shader factors, bits 4-7 the source
+// factor code, bits 8-11 the destination code; z/w the fixed colours.
+std::array<std::uint32_t, 3> shader_blend_uniforms(const GeGpuDrawDescriptor &draw) noexcept {
+    if (!general_blend(draw).shader_factors) return {0u, 0u, 0u};
+    return {1u | ((draw.blend_source_factor & 0xFu) << 4u) | ((draw.blend_dest_factor & 0xFu) << 8u),
+            draw.blend_fix_source & 0x00FFFFFFu, draw.blend_fix_dest & 0x00FFFFFFu};
+}
