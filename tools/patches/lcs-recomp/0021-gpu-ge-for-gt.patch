+// GT patch 0021: the PSP picture times the smallest whole scale that covers a width x height surface,
+// between x1 and `max_scale` (at most x8). Whole scales keep every PSP pixel the same size.
+[[nodiscard]] constexpr InternalResolutionDimensions uniform_internal_resolution(
+    std::uint32_t width, std::uint32_t height, std::uint32_t max_scale) noexcept {
+    std::uint32_t scale = (width + 479u) / 480u;
+    if ((height + 271u) / 272u > scale) scale = (height + 271u) / 272u;
+    const std::uint32_t cap = max_scale < 1u ? 1u : (max_scale > 8u ? 8u : max_scale);
+    if (scale > cap) scale = cap;
+    if (scale < 1u) scale = 1u;
+    return {480u * scale, 272u * scale};
+}
