+// Bytes of guest memory a texture's base level reads.
+std::uint64_t texture_bytes(const GeGpuDrawDescriptor &d) noexcept {
+    const std::uint32_t width = std::max(d.texture_buffer_width, d.texture_width);
+    std::uint64_t size = static_cast<std::uint64_t>(width) * std::max(1u, d.texture_height);
+    switch (d.texture_format) {
+    case 3u: case 7u: return size * 4u;
+    case 4u: return (size + 1u) / 2u;
+    case 5u: return size;
+    case 8u: return size / 2u;          // DXT1: 4 bits per pixel
+    case 9u: case 10u: return size;     // DXT3/5: 8 bits per pixel
+    default: return size * 2u;
+    }
+}
+
+// The newest write stamp on the pages a texture reads (0: none reported since start).
+std::uint64_t newest_write(const VulkanState &s, const GeGpuDrawDescriptor &d) noexcept {
+    const std::uint64_t begin = d.texture_address & 0x0FFFFFFFu;
+    const std::uint64_t last = std::min<std::uint64_t>(begin + std::max<std::uint64_t>(1u, texture_bytes(d)) - 1u,
+                                                       0x0FFFFFFFu);
+    std::uint64_t newest = 0u;
+    for (std::uint64_t page = begin >> kGuestPageShift; page <= last >> kGuestPageShift; ++page)
+        newest = std::max(newest, s.page_write_stamp[page]);
+    return newest;
+}
+
+// Whether a reported write touched the texture after it was last checked.
+bool written_since_check(const VulkanState &s, const Texture &texture) noexcept {
+    return texture.checked_write_clock != s.write_clock &&
+           newest_write(s, texture.descriptor) > texture.checked_write_clock;
+}
