+    bool equal = streamed.vertices.size() == ordinary.vertices.size() && streamed.indices == ordinary.indices &&
+                 streamed.batches.size() == ordinary.batches.size() && streamed.draws == ordinary.draws &&
+                 streamed.triangles == ordinary.triangles && streamed.game_vertices == ordinary.game_vertices &&
+                 streamed.overflows == ordinary.overflows;
+    for (std::size_t i = 0u; equal && i < streamed.vertices.size(); ++i)
+        equal = same_vertex(streamed.vertices[i], ordinary.vertices[i]);
+    for (std::size_t i = 0u; equal && i < streamed.batches.size(); ++i)
+        equal = same_batch(streamed.batches[i], ordinary.batches[i]);
+    g_stream_verified.fetch_add(1u, std::memory_order_relaxed);
+    if (!equal) g_stream_mismatches.fetch_add(1u, std::memory_order_relaxed);
+    return true;
+}
