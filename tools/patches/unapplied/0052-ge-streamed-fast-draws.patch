+// Whether the stream still describes the last batch, as accumulate would find it for a draw of the run.
+bool stream_current(const VulkanState &s, const GeGpuStream &stream) noexcept {
+    return stream.valid && s.enabled && blend_stats() == nullptr && stream.epoch == s.frame_epoch &&
+           stream.target_generation == s.target_generation && !s.batches.empty() &&
+           stream.batch == s.batches.size() - 1u &&
+           s.batches.back().first_index + s.batches.back().index_count == s.indices.size();
+}
+
+// What accumulate does for a draw of the run that joins the last batch (its merge branch), from upload-ready vertices.
+// The caller holds the lock and checked stream_current.
+void stream_append_locked(VulkanState &s, GeGpuStream &stream, std::span<const GeGpuStreamVertex> vertices,
+                          std::span<const std::uint32_t> strip_indices, const GeGpuStreamLevel &level) {
+    const std::size_t emitted = strip_indices.size();
+    if (vertices.empty() || emitted == 0u || emitted % 3u != 0u) return;  // as accumulate: nothing to draw
+    const std::size_t used = s.vertices.size() * sizeof(UploadVertex) + s.indices.size() * sizeof(std::uint32_t);
+    if (used + vertices.size() * sizeof(UploadVertex) + emitted * sizeof(std::uint32_t) > kGeometryUploadCapacity) {
+        ++s.report.game_vertex_overflows;
+        return;
+    }
+    for (std::uint32_t index : strip_indices)
+        if (index >= vertices.size()) {
+            ++s.report.game_vertex_overflows;
+            return;
+        }
+    stream.draw.texture_level_mode = level.mode;
+    stream.draw.texture_level_offset16 = level.offset16;
+    stream.draw.texture_selected_level = level.selected;
+    const float lod = vertex_lod(s, stream.draw);  // GT patch 0039, 0043: as accumulate, from this draw's level
+    const std::uint32_t first_vertex = static_cast<std::uint32_t>(s.vertices.size());
+    s.vertices.resize(first_vertex + vertices.size());
+    UploadVertex *appended = s.vertices.data() + first_vertex;
+    UvBox box{};
+    for (std::size_t i = 0u; i < vertices.size(); ++i) {
+        const GeGpuStreamVertex &source = vertices[i];
+        appended[i] = {source.x, source.y, source.z, 1.0f, source.rgba, source.u, source.v, 1.0f, 1.0f};
+        appended[i].lod = lod;
+        if (stream.uv_box)
+            extend_uv_box(box.valid, box.box, source.u * stream.uv_scale_u + stream.uv_offset_u,
+                          source.v * stream.uv_scale_v + stream.uv_offset_v, 1.0f);
+    }
+    Batch &last = s.batches.back();
+    const std::uint32_t shift = first_vertex - last.first_vertex;
+    const std::size_t first_index = s.indices.size();
+    s.indices.resize(first_index + emitted);
+    for (std::size_t i = 0u; i < emitted; ++i) s.indices[first_index + i] = strip_indices[i] + shift;
+    last.vertex_count += static_cast<std::uint32_t>(vertices.size());
+    last.index_count += static_cast<std::uint32_t>(emitted);
+    last.logical_draw_count += stream.logical;
+    if (!last.uv_box_valid || !box.valid) {  // accumulate's merge_box
+        last.uv_box_valid = false;
+        last.uv_box[0] = -1.0e30f;
+    } else {
+        extend_uv_box(last, box.box[0], box.box[1], 1.0f);
+        extend_uv_box(last, box.box[2], box.box[3], 1.0f);
+    }
+    s.report.game_draw_calls += stream.logical;
+    s.report.game_triangles += emitted / 3u;
+    s.report.game_vertices += emitted;
+}
