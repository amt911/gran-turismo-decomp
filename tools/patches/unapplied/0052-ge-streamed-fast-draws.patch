+bool ge_gpu_backend_stream_begin(const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                                 GeGpuStream &stream) noexcept {
+    VulkanState &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    stream.valid = false;
+    if (!s.enabled || s.batches.empty() || transform.primitive != 3u) return false;
+    const Batch &last = s.batches.back();
+    // Only a run that keeps joining: an indexed hardware triangle batch that samples no render target, with this
+    // draw's descriptor and transform (accumulate's merge test, which the next draws of the run would pass).
+    constexpr std::size_t kTransformCompared = offsetof(GeGpuHardwareTransform, logical_prim_batches);
+    const bool sampled_target = draw.texture_enabled && texture_target(s, draw.texture_address) != nullptr;
+    if (sampled_target || !last.hardware_transform || last.framebuffer_feedback || last.transform.primitive != 3u ||
+        !last.indexed || std::memcmp(&last.transform, &transform, kTransformCompared) != 0 ||
+        !same_draw_but_per_draw_fields(last.draw, draw))
+        return false;
+    stream.epoch = s.frame_epoch;
+    stream.target_generation = s.target_generation;
+    stream.batch = s.batches.size() - 1u;
+    std::memcpy(static_cast<void *>(&stream.draw), &draw, sizeof draw);  // zero padding kept (patch 0046)
+    stream.uv_box = draw.texture_enabled;  // and no sampled target (above)
+    stream.uv_scale_u = transform.uv_scale_u;
+    stream.uv_offset_u = transform.uv_offset_u;
+    stream.uv_scale_v = transform.uv_scale_v;
+    stream.uv_offset_v = transform.uv_offset_v;
+    stream.logical = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    stream.valid = true;
+    return true;
+}
+
+bool ge_gpu_backend_stream_append(GeGpuStream &stream, std::span<const GeGpuStreamVertex> vertices,
+                                  std::span<const std::uint32_t> strip_indices, const GeGpuStreamLevel &level) noexcept {
+    VulkanState &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!stream_current(s, stream)) {
+        stream.valid = false;
+        return false;
+    }
+    stream_append_locked(s, stream, vertices, strip_indices, level);
+    g_streamed_draws.fetch_add(1u, std::memory_order_relaxed);
+    return true;
+}
