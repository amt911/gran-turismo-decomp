+// GT patch 0052: the static-strip arena (docs/superpowers/specs/2026-10-20-ge-static-strip-arena-design.md).
+namespace {
+
+// GT_GE_ARENA_SABOTAGE=1 moves the first vertex of every recorded strip, =2 skips the signature compare: the verify
+// mode must report both (a check that never failed proves nothing).
+int arena_sabotage() noexcept {
+    static const int mode = [] { const char *v = std::getenv("GT_GE_ARENA_SABOTAGE"); return v ? std::atoi(v) : 0; }();
+    return mode;
+}
+
+std::uint64_t arena_key(const GeGpuStaticStripKey &key) noexcept {
+    return (static_cast<std::uint64_t>(key.address) << 32u) | (static_cast<std::uint64_t>(key.layout_type & 0xFFFFFFu) << 8u) |
+           (key.count & 0xFFu);
+}
+
+// The draw of a recorded strip, with the batch rule of ge_gpu_backend_accumulate_hardware_triangles: it joins the batch
+// before when that one is an arena batch with the same descriptor (but the per-draw fields) and transform and none of
+// the two samples a render target; its indices are then shifted to the batch's first vertex, which must not lie
+// after the strip's (the draw's vertex offset is the batch's).
+void draw_arena_strip(VulkanState &s, const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                      ArenaStrip &strip) noexcept {
+    const std::size_t used = s.vertices.size() * sizeof(UploadVertex) + s.indices.size() * sizeof(std::uint32_t);
+    if (used + strip.indices.size() * sizeof(std::uint32_t) > kFrameGeometryCapacity) {
+        ++s.report.game_vertex_overflows;
+        return;
+    }
+    const std::uint32_t first_index = static_cast<std::uint32_t>(s.indices.size());
+    const bool sampled_target = draw.texture_enabled && texture_target(s, draw.texture_address) != nullptr;
+    UvBox box{};
+    if (draw.texture_enabled && !sampled_target) {
+        const float key[4] = {transform.uv_scale_u, transform.uv_offset_u, transform.uv_scale_v, transform.uv_offset_v};
+        if (!strip.box_known || std::memcmp(strip.box_transform, key, sizeof key) != 0) {
+            strip.box_valid = false;
+            float range[4]{};
+            for (std::uint32_t i = 0u; i < strip.count; ++i) {
+                const UploadVertex &v = s.arena[strip.first + i];
+                extend_uv_box(strip.box_valid, range, v.u * transform.uv_scale_u + transform.uv_offset_u,
+                              v.v * transform.uv_scale_v + transform.uv_offset_v, v.q);
+            }
+            std::copy(std::begin(range), std::end(range), std::begin(strip.box));
+            std::memcpy(strip.box_transform, key, sizeof key);
+            strip.box_known = true;
+        }
+        box.valid = strip.box_valid;
+        std::copy(std::begin(strip.box), std::end(strip.box), std::begin(box.box));
+    }
+    const std::uint32_t logical = std::max<std::uint32_t>(1u, transform.logical_prim_batches);
+    const std::size_t emitted = strip.indices.size();
+    if (transform.primitive == 3u && !s.batches.empty()) {
+        Batch &last = s.batches.back();
+        constexpr std::size_t kTransformCompared = offsetof(GeGpuHardwareTransform, logical_prim_batches);
+        if (!sampled_target && last.arena && last.hardware_transform && !last.framebuffer_feedback &&
+            last.transform.primitive == 3u && last.indexed && last.first_index + last.index_count == first_index &&
+            strip.first >= last.first_vertex && std::memcmp(&last.transform, &transform, kTransformCompared) == 0 &&
+            same_draw_but_per_draw_fields(last.draw, draw)) {
+            const std::uint32_t shift = strip.first - last.first_vertex;
+            s.indices.resize(first_index + emitted);
+            for (std::size_t i = 0u; i < emitted; ++i) s.indices[first_index + i] = strip.indices[i] + shift;
+            last.vertex_count = std::max(last.vertex_count, shift + strip.count);
+            last.index_count += static_cast<std::uint32_t>(emitted);
+            last.logical_draw_count += logical;
+            merge_uv_box(last, box);
+            s.report.game_draw_calls += logical;
+            s.report.game_triangles += emitted / 3u;
+            s.report.game_vertices += emitted;
+            return;
+        }
+    }
+    s.indices.insert(s.indices.end(), strip.indices.begin(), strip.indices.end());
+    Batch batch{};
+    batch.draw = draw;
+    batch.first_vertex = strip.first;
+    batch.vertex_count = strip.count;
+    batch.first_index = first_index;
+    batch.index_count = static_cast<std::uint32_t>(emitted);
+    batch.indexed = true;
+    batch.logical_draw_count = logical;
+    batch.hardware_transform = true;
+    batch.transform = transform;
+    batch.uv_box_valid = box.valid;
+    std::copy(std::begin(box.box), std::end(box.box), std::begin(batch.uv_box));
+    batch.feedback_address = draw.texture_address & 0x001FFFF0u;
+    batch.framebuffer_feedback = sampled_target;
+    batch.arena = true;
+    s.batches.push_back(batch);
+    s.report.game_draw_calls += logical;
+    s.report.game_triangles += transform.primitive == 4u
+        ? (emitted > 2u ? emitted - 2u : 0u) : emitted / 3u;
+    s.report.game_vertices += emitted;
+    s.report.hw_transform_draw_calls += logical;
+    s.report.hw_transform_vertices += strip.count;
+    const bool sampled = draw.texture_enabled && ge_gpu_backend_texture_available(draw);
+    if (draw.texture_enabled && sampled) s.report.textured_game_draw_calls += logical;
+    else if (draw.texture_enabled) s.report.game_textured_draws_without_texture += logical;
+}
+
+// The end of a frame's recording: no batch references the arena any more, so a full one can be emptied (its GPU copy
+// is rewritten from the start at the next frame's upload, after that frame's fence wait).
+void end_arena_frame(VulkanState &s) noexcept {
+    if (!s.arena_reset_pending) return;
+    s.arena.clear();
+    s.arena_strips.clear();
+    s.arena_uploaded = 0u;
+    s.arena_reset_pending = false;
+    ++s.arena_stats.resets;
+}
+
+}  // namespace
+
+bool ge_gpu_backend_static_arena_enabled() noexcept {
+    static const bool enabled = std::getenv("GT_GE_NO_ARENA") == nullptr;
+    return enabled;
+}
+
+bool ge_gpu_backend_static_strip_draw(const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                                      const GeGpuStaticStripKey &key, std::span<const std::byte> signature,
+                                      std::span<const GeGpuVertex> verify_vertices) noexcept {
+    VulkanState &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled) return false;
+    const auto found = s.arena_strips.find(arena_key(key));
+    if (found == s.arena_strips.end()) return false;
+    ArenaStrip &strip = found->second;
+    if (arena_sabotage() != 2 && (strip.signature.size() != signature.size() ||
+                                  std::memcmp(strip.signature.data(), signature.data(), signature.size()) != 0))
+        return false;
+    const float lod = vertex_lod(s, draw);
+    if (std::memcmp(&lod, &strip.lod, sizeof lod) != 0) {
+        ++s.arena_stats.lod_misses;
+        return false;
+    }
+    if (!verify_vertices.empty()) {
+        ++s.arena_stats.verified;
+        bool same = verify_vertices.size() == strip.count;
+        for (std::uint32_t i = 0u; same && i < strip.count; ++i) {
+            UploadVertex fresh = make_upload_vertex(verify_vertices[i]);
+            fresh.lod = lod;
+            same = std::memcmp(&fresh, &s.arena[strip.first + i], sizeof fresh) == 0;
+        }
+        if (!same && s.arena_stats.mismatches++ < 8u)
+            std::fprintf(stderr, "[arena-verify] strip %08X x%u (type %06X) differs from its arena copy\n",
+                         key.address, key.count, key.layout_type);
+    }
+    draw_arena_strip(s, draw, transform, strip);
+    ++s.arena_stats.hits;
+    return true;
+}
+
+void ge_gpu_backend_static_strip_record(const GeGpuDrawDescriptor &draw, const GeGpuHardwareTransform &transform,
+                                        const GeGpuStaticStripKey &key, std::span<const std::byte> signature,
+                                        std::span<const GeGpuVertex> vertices,
+                                        std::span<const std::uint32_t> triangle_indices) noexcept {
+    VulkanState &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    if (!s.enabled) return;
+    bool recordable = !vertices.empty() && vertices.size() <= 0xFFu && key.count == vertices.size() &&
+                      transform.primitive == 3u && triangle_indices.size() >= 3u && triangle_indices.size() % 3u == 0u;
+    for (std::uint32_t index : triangle_indices) recordable = recordable && index < vertices.size();
+    if (recordable && (s.arena_reset_pending || s.arena.size() + vertices.size() > kArenaVertices)) {
+        s.arena_reset_pending = true;  // full: emptied when this frame ends, the strips drawn the ordinary way till then
+        recordable = false;
+    }
+    if (!recordable) {
+        ge_gpu_backend_accumulate_hardware_triangles(draw, transform, vertices, triangle_indices);
+        return;
+    }
+    ArenaStrip strip;
+    strip.first = static_cast<std::uint32_t>(s.arena.size());
+    strip.count = static_cast<std::uint32_t>(vertices.size());
+    strip.lod = vertex_lod(s, draw);
+    strip.signature.assign(signature.begin(), signature.end());
+    strip.indices.assign(triangle_indices.begin(), triangle_indices.end());
+    s.arena.resize(strip.first + strip.count);
+    for (std::uint32_t i = 0u; i < strip.count; ++i) {
+        UploadVertex vertex = make_upload_vertex(vertices[i]);
+        vertex.lod = strip.lod;
+        s.arena[strip.first + i] = vertex;
+    }
+    if (arena_sabotage() == 1) s.arena[strip.first].x += 1.0f;
+    ++s.arena_stats.records;
+    ArenaStrip &kept = s.arena_strips[arena_key(key)] = std::move(strip);  // a changed strip gets new arena vertices
+    draw_arena_strip(s, draw, transform, kept);
+}
+
+GeGpuArenaStats ge_gpu_backend_take_arena_stats() noexcept {
+    VulkanState &s = state();
+    std::lock_guard<std::recursive_mutex> guard(s.mutex);
+    GeGpuArenaStats stats = s.arena_stats;
+    stats.vertices = s.arena.size();
+    s.arena_stats = GeGpuArenaStats{};
+    return stats;
+}
